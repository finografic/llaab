    "astro": "^6.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "7.71.1",
    "react-i18next": "16.5.4",
    "react-json-tree": "0.20.0",
    "type-fest": "^5.4.4",
    "use-debounce": "10.1.0",
