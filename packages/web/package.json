{
  "name": "@llaab/web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "astro": "astro",
    "·········· LINTING": "····················································",
    "lint": "eslint .",
    "lint.fix": "eslint . --fix",
    "·········· FORMATTING": "················································",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "·········· TESTING": "····················································",
    "test.all": "vitest run --reporter=verbose",
    "test.filters": "vitest run src/utils/filters --reporter=verbose",
    "·········· PACKAGES": "···················································",
    "update.design-system": "pnpm update @finografic/design-system --latest",
    "update.icons": "pnpm update @finografic/icons --latest",
    "update:oxfmt-config": "pnpm update @finografic/oxfmt-config --latest && pnpm update oxfmt --latest",
    "update.eslint-config": "pnpm update @finografic/eslint-config --latest",
    "update.project-scripts": "pnpm update @finografic/project-scripts --latest --recursive",
    "update.zustand-context": "pnpm update @finografic/zustand-context-creator --latest",
    "·········· UPDATE.DEPS": "···············································",
    "update.all": "pnpm update --latest",
    "update.ignore": "npx tsx scripts/update-deps-ignore.ts",
    "·········· UTILS": "······················································",
    "tsc.debug": "pnpm exec tsc --pretty --project tsconfig.json",
    "typecheck": "pnpm exec tsc --project tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/react": "^5.0.2",
