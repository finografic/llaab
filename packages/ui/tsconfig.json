{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      "@llaab/ui/*": ["./src/*"],
      "ui/*": ["./src/components/*"],
      "hooks/*": ["./src/hooks/*"],
      "utils": ["./src/lib/utils"]
    }
  },
  "include": ["."],
  "exclude": ["node_modules", "dist"]
}
