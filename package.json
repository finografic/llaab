{
  "name": "llaab",
  "private": true,
  "type": "module",
  "scripts": {
    "---------- DEV_AND_BUILD": "---------------------------------------------",
    "dev": "turbo dev",
    "dev:cli": "bun packages/cli/src/index.ts",
    "dev:clean:vault:recent:2h": "bun scripts/clean-recent-vault-activity.ts --hours 2 --yes",
    "dev:clean:vault:recent": "bun scripts/clean-recent-vault-activity.ts",
    "build": "turbo build",
    "·········· TESTING": "···················································",
    "test": "vitest test",
    "test:coverage": "turbo test --coverage",
    "·········· LINTING": "···················································",
    "lint": "turbo lint",
    "lint:fix": "turbo lint --fix",
    "lint.md": "md-lint",
    "lint.md.fix": "md-lint --fix",
    "·········· FORMATTING": "················································",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "·········· PACKAGES_ROOT": "·············································",
    "update:md-lint": "pnpm update @finografic/md-lint --latest --recursive",
    "update:oxfmt": "pnpm update @finografic/oxfmt-config oxfmt --latest",
    "update:project-scripts": "pnpm update @finografic/project-scripts --latest",
    "·········· PACKAGES_WEB": "··············································",
    "update:design-system": "pnpm --filter @llaab/client update.design-system",
    "update:icons": "pnpm --filter @llaab/client update.icons",
    "update:zustand-context": "pnpm --filter @llaab/client update.zustand-context",
    "·········· PACKAGES_BATCH": "············································",
    "update:finografic": "pnpm run update:oxfmt && pnpm run update:md-lint && pnpm run update:design-system && pnpm run update:icons && pnpm run update:zustand-context",
    "upgrade:deps:all": "pnpm update --latest --recursive",
    "·········· CLEAN": "·····················································",
    "clean": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --detach",
    "clean.turbo": "turbo run clean",
    "·········· UTILS": "·····················································",
    "list:managed-repos": "tsx --tsconfig tsconfig.scripts.json scripts/list-managed-repos.ts",
    "check:cli-core-spec": "node scripts/check-cli-core-template.mjs",
    "tsc:debug": "tsc --pretty --project tsconfig.json",
    "typecheck": "turbo typecheck",
    "prepack": "pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.2",
    "@finografic/md-lint": "0.6.1",
    "@finografic/oxfmt-config": "^1.7.4",
    "@finografic/project-scripts": "^1.3.3",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "9.39.2",
    "eslint-plugin-markdownlint": "^0.9.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.44.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "LOCAL_DEP_EXAMPLE": {
    "@finografic/md-lint": "file:/Users/justin/repos-finografic/@finografic-md-lint"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "eslint --fix"
    ],
    "*.md": [
      "oxfmt --no-error-on-unmatched-pattern",
      "md-lint --fix"
    ],
    "*.{json,jsonc,yml,yaml,toml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
