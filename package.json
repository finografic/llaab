{
  "name": "llaab",
  "private": true,
  "type": "module",
  "scripts": {
    "---------- DEV_AND_BUILD": "---------------------------------------------",
    "services:start": "scripts/macos/llaab-service.sh start",
    "dev:clean:vault:recent:6h": "bun scripts/clean-recent-vault-activity.ts --hours 6 --yes",
    "dev:clean:vault:recent": "bun scripts/clean-recent-vault-activity.ts",
    "dev:reset": "run-s reset",
    "dev": "turbo dev",
    "build": "turbo build",
    "·········· CLI": "·······················································",
    "dev:cli": "bun packages/cli/src/index.ts",
    "build:cli": "pnpm --filter @llaab/cli build",
    "link": "pnpm --filter @llaab/cli link",
    "unlink": "pnpm --filter @llaab/cli unlink",
    "·········· TESTING": "···················································",
    "test": "vitest test",
    "test:coverage": "turbo test --coverage",
    "·········· LINTING": "···················································",
    "lint": "oxlint -c oxlint.config.ts",
    "lint:fix": "oxlint -c oxlint.config.ts --fix",
    "lint:ci": "oxlint -c oxlint.config.ts --quiet",
    "lint:md": "md-lint",
    "lint:md:fix": "md-lint --fix",
    "·········· FORMATTING": "················································",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "·········· ICONS": "·····················································",
    "icons": "pnpm --filter @llaab/icons dev",
    "·········· PACKAGES": "············································",
    "update:finografic": "pnpm update:oxfmt && pnpm update:md-lint && pnpm update:project-scripts && pnpm update:zustand-context",
    "update:oxc-config": "pnpm update @finografic/oxc-config --latest --recursive && pnpm update oxfmt --latest --recursive && pnpm update oxlint --latest --recursive",
    "update:md-lint": "pnpm update @finografic/md-lint --latest --recursive",
    "update:project-scripts": "pnpm update @finografic/project-scripts --latest --recursive",
    "update:icons": "pnpm --filter @llaab/icons update:lucide-manager && pnpm --filter @llaab/icons update:icons",
    "update:zustand-context": "pnpm --filter @llaab/client update:zustand-context",
    "update:deps:all": "pnpm update --latest --recursive",
    "update:deps:ignore": "npx tsx scripts/update-deps-ignore.ts",
    "·········· VERSIONING": "················································",
    "version:patch": "bun scripts/bump-version.ts patch",
    "version:minor": "bun scripts/bump-version.ts minor",
    "version:major": "bun scripts/bump-version.ts major",
    "·········· RESET": "·····················································",
    "reset": "run-s clean reset:install reset:sync build",
    "reset:sync": "pnpm syncpack:fix",
    "reset:install": "pnpm install",
    "·········· CLEAN": "·····················································",
    "clean": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --detach",
    "clean:turbo": "turbo run clean",
    "·········· SYNCPACK": "·················································",
    "syncpack:check": "syncpack lint",
    "syncpack:fix": "syncpack fix",
    "·········· UTILS": "·····················································",
    "list:managed-repos": "tsx --tsconfig tsconfig.scripts.json scripts/list-managed-repos.ts",
    "check:cli-core-spec": "node scripts/check-cli-core-template.mjs",
    "tsc:debug": "tsc --pretty --project tsconfig.json",
    "typecheck": "turbo typecheck",
    "prepack": "pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@finografic/md-lint": "^0.16.4",
    "@finografic/oxc-config": "^2.6.6",
    "@finografic/project-scripts": "^1.3.3",
    "@types/bun": "1.3.14",
    "@types/node": "25.9.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^0.23.0",
    "prettier": "^3.8.3",
    "syncpack": "^14.3.0",
    "tsdown": "^0.22.1",
    "turbo": "^2.9.15",
    "typescript": "6.0.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "typescript": "6.0.3"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix"
    ],
    "*.md": [
      "oxfmt --no-error-on-unmatched-pattern",
      "md-lint --fix"
    ],
    "*.{json,jsonc,yml,yaml,toml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "apps/client/**/*.astro": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.16.0"
  }
}
