{
  "name": "llaab",
  "private": true,
  "type": "module",
  "scripts": {
    "---------- DEV_AND_BUILD": "---------------------------------------------",
    "dev": "turbo dev",
    "dev:cli": "bun packages/cli/src/index.ts",
    "dev:reset": "run-s reset",
    "dev:clean:vault:recent:2h": "bun scripts/clean-recent-vault-activity.ts --hours 2 --yes",
    "dev:clean:vault:recent": "bun scripts/clean-recent-vault-activity.ts",
    "build": "turbo build",
    "panda:codegen": "pnpm --filter @llaab/client panda:codegen",
    "·········· TESTING": "···················································",
    "test": "vitest test",
    "test:coverage": "turbo test --coverage",
    "·········· LINTING": "···················································",
    "lint": "oxlint -c oxlint.config.ts",
    "lint:fix": "oxlint -c oxlint.config.ts --fix",
    "lint:ci": "oxlint -c oxlint.config.ts --quiet",
    "lint:md": "md-lint",
    "lint:md:fix": "md-lint --fix",
    "·········· FORMATTING": "················································",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "·········· PACKAGES_ROOT": "·············································",
    "update:oxc-config": "pnpm update @finografic/oxc-config --latest && pnpm update oxfmt --latest && pnpm update oxlint --latest",
    "update:md-lint": "pnpm update @finografic/md-lint --latest --recursive",
    "update:project-scripts": "pnpm update @finografic/project-scripts --latest",
    "·········· PACKAGES_WEB": "··············································",
    "update:design-system": "pnpm --filter @llaab/client update:design-system",
    "update:icons": "pnpm --filter @llaab/client update:icons",
    "update:zustand-context": "pnpm --filter @llaab/client update:zustand-context",
    "·········· PACKAGES_BATCH": "············································",
    "update:finografic": "pnpm run update:oxfmt && pnpm run update:md-lint && pnpm run update:project-scripts && pnpm run update:design-system && pnpm run update:icons && pnpm run update:zustand-context",
    "upgrade:deps:all": "pnpm update --latest --recursive",
    "·········· RESET": "·····················································",
    "reset": "run-s clean reset:install reset:sync reset:build",
    "reset:sync": "pnpm syncpack:fix",
    "reset:install": "pnpm install",
    "reset:build": "turbo build",
    "·········· CLEAN": "·····················································",
    "clean": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --detach",
    "clean:turbo": "turbo run clean",
    "·········· SYNCPACK": "·················································",
    "syncpack:check": "syncpack lint",
    "syncpack:fix": "syncpack fix",
    "·········· UTILS": "·····················································",
    "list:managed-repos": "tsx --tsconfig tsconfig.scripts.json scripts/list-managed-repos.ts",
    "check:cli-core-spec": "node scripts/check-cli-core-template.mjs",
    "tsc:debug": "tsc --pretty --project tsconfig.json",
    "typecheck": "turbo typecheck",
    "prepack": "pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@finografic/md-lint": "^0.10.1",
    "@finografic/oxc-config": "^2.6.2",
    "@finografic/project-scripts": "^1.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "24.12.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "syncpack": "^14.3.0",
    "tsdown": "^0.22.1",
    "turbo": "^2.5.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "LOCAL_DEP_EXAMPLE": {
    "@finografic/md-lint": "file:/Users/justin/repos-finografic/@finografic-md-lint"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix"
    ],
    "*.md": [
      "oxfmt --no-error-on-unmatched-pattern",
      "md-lint --fix"
    ],
    "*.{json,jsonc,yml,yaml,toml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
