{
  "name": "llaab",
  "private": true,
  "type": "module",
  "scripts": {
    "---------- DEV_AND_BUILD": "---------------------------------------------",
    "dev": "turbo dev",
    "dev:cli": "bun packages/cli/src/index.ts",
    "build": "turbo build",
    "·········· TESTING": "···················································",
    "test": "vitest test",
    "test:coverage": "turbo test --coverage",
    "·········· LINTING": "···················································",
    "lint": "turbo lint",
    "lint:fix": "turbo lint --fix",
    "lint.md": "md-lint",
    "lint.md.fix": "md-lint --fix",
    "············ FORMATTING": "··············································",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "·········· PACKAGES": "··················································",
    "update:deps-policy": "pnpm update @finografic/deps-policy --latest",
    "update:core": "pnpm update @finografic/core --latest",
    "update:eslint-config": "pnpm update @finografic/eslint-config --latest",
    "update:md-lint": "pnpm update @finografic/md-lint --latest",
    "update:oxfmt-config": "pnpm update @finografic/oxfmt-config --latest && pnpm update oxfmt --latest",
    "update:project-scripts": "pnpm update @finografic/project-scripts --latest",
    "upgrade:deps:all": "pnpm update --latest",
    "·········· UTILS": "·····················································",
    "list:managed-repos": "tsx --tsconfig tsconfig.scripts.json scripts/list-managed-repos.ts",
    "check:cli-core-spec": "node scripts/check-cli-core-template.mjs",
    "tsc:debug": "tsc --pretty --project tsconfig.json",
    "typecheck": "turbo typecheck",
    "prepack": "pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.2",
    "@finografic/md-lint": "^0.4.2",
    "@finografic/oxfmt-config": "^1.0.3",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "9.39.2",
    "eslint-plugin-markdownlint": "^0.9.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.42.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "eslint --fix"
    ],
    "*.md": [
      "oxfmt --no-error-on-unmatched-pattern",
      "md-lint --fix"
    ],
    "*.{json,jsonc,yml,yaml,toml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
