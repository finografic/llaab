{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@llaab/ui/*": ["../../packages/ui/src/*"],
      "components/ui/*": ["../../packages/ui/src/components/*"],
      "components/*": ["./src/components/*"],
      "dialogs/*": ["./src/dialogs/*"],
      "forms/*": ["./src/forms/*"],
      "layouts/*": ["./src/layouts/*"],
      "lib/*": ["./src/lib/*"],
      "pages/*": ["./src/pages/*"],
      "providers/*": ["./src/providers/*"],
      "styles/*": ["./src/styles/*"],
      "tables/*": ["./src/tables/*"],
      "utils/*": ["./src/utils/*"],
      "queries/*": ["./src/queries/*"]
    }
  },
  "include": ["./.astro/types.d.ts", "**/*"],
  "exclude": ["./dist"]
}
