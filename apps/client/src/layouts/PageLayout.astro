---
/**
 * PageLayout — Finder-style inner-page template.
 *
 * Zone map:
 *   ┌─ slot: hero ───────────────────────────────────────────────┐
 *   │  PageHero goes here (title, eyebrow, actions)              │
 *   └────────────────────────────────────────────────────────────┘
 *   ┌─ slot: aside (optional) ──┐ ┌─ default slot ──────────────┐
 *   │  Filters, facets, sub-nav │ │  FileList, content, etc.    │
 *   └───────────────────────────┘ └─────────────────────────────┘
 *
 * Usage:
 *   <PageLayout>
 *     <PageHero slot="hero" title="Transcripts" eyebrow="Vault" />
 *     <FilterSidebar slot="aside" />
 *     <FileList data={transcripts} columns={columns} />
 *   </PageLayout>
 *
 * Props:
 *   asideWidth  — width of the aside panel (default 200px)
 *   hasAside    — show/hide the aside column (default: true when aside slot filled)
 */

interface Props {
  asideWidth?: string;
}

const { asideWidth = '200px' } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<div class="page-layout">
  {Astro.slots.has('hero') && (
    <div class="page-hero-zone">
      <slot name="hero" />
    </div>
  )}

  <div class="page-body" data-has-aside={hasAside || undefined}>
    {hasAside && (
      <aside class="page-aside" style={`--aside-w: ${asideWidth}`}>
        <slot name="aside" />
      </aside>
    )}

    <div class="page-main">
      <slot />
    </div>
  </div>
</div>

<style>
  .page-layout {
    display: grid;
    grid-template-rows: auto 1fr;
    /* Fill the parent — AppLayout's .page-content handles outer scroll */
    min-height: 100%;
  }

  /* ─── Hero zone ──────────────────────────────────────────────── */

  .page-hero-zone {
    flex-shrink: 0;
  }

  /* ─── Body ───────────────────────────────────────────────────── */

  .page-body {
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
    min-height: 0;
  }

  .page-body[data-has-aside] {
    grid-template-columns: var(--aside-w, 200px) 1fr;
  }

  /* ─── Aside ──────────────────────────────────────────────────── */

  .page-aside {
    border-right: 1px solid var(--border-subtle);
    overflow-y: auto;
    background: var(--bg);
  }

  /* ─── Main ───────────────────────────────────────────────────── */

  .page-main {
    overflow-y: auto;
    min-width: 0;
  }
</style>
