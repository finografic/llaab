---
/**
 * AppLayout — primary shell for all main app routes.
 *
 * Structure:
 *   ┌─────────────────────────────────────┐
 *   │ AppHeader (brand + NavMenu + title) │
 *   ├─────────────────────────────────────┤
 *   │ <slot />                            │
 *   ├─────────────────────────────────────┤
 *   │ AppFooter                           │
 *   └─────────────────────────────────────┘
 *
 * Props:
 *   title   — passed to AppHeader and <title> tag
 */
import AppFooter from 'components/AppFooter/AppFooter.astro';
import AppHeader from 'components/AppHeader/AppHeader.astro';
import { Toaster } from 'components/ui/sonner';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} — LLAAB` : 'LLAAB';
---

<BaseLayout title={pageTitle}>
  <div class="app-shell">
    <AppHeader title={title} />

    <main class="page-content">
      <slot />
    </main>

    <AppFooter />
  </div>

  <Toaster client:only="react" />
</BaseLayout>

<style>
  .app-shell {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    width: 100%;
    background: var(--bg);
  }

  .page-content {
    flex: 1;
    padding: 1.5rem;
    overflow-y: auto;
  }
</style>
