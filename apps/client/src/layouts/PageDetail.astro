---
/**
 * PageDetail — content column for vault entity detail routes.
 *
 * Props:
 *   variant — max-width preset (default page detail width; narrow is explicit)
 *   gap     — vertical spacing between stacked sections
 */

interface Props {
  variant?: 'narrow' | 'default';
  gap?: 'md' | 'lg';
}

const { variant = 'default', gap = 'md' } = Astro.props;
---

<div class="page-detail" data-variant={variant} data-gap={gap}>
  <slot />
</div>

<style>
  .page-detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: var(--page-detail-max);
  }

  .page-detail[data-variant='narrow'] {
    max-width: var(--content-narrow-max);
  }

  .page-detail[data-gap='lg'] {
    gap: var(--space-8);
  }
</style>
