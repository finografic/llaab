---
interface ModelMeta {
  model?: string;
  provider?: string;
  durationMs?: number;
  promptTokens?: number;
  completionTokens?: number;
}

interface Props {
  meta: ModelMeta;
  title?: string;
}

const { meta, title = 'Model metadata' } = Astro.props;
const totalTokens = (meta.promptTokens ?? 0) + (meta.completionTokens ?? 0);
const hasMetadata = Boolean(
  meta.model ||
  meta.provider ||
  meta.durationMs != null ||
  meta.promptTokens != null ||
  meta.completionTokens != null,
);

function formatDuration(ms?: number): string {
  if (ms == null) return '—';
  if (ms < 1000) return `${ms}ms`;
  return `${(ms / 1000).toFixed(1)}s`;
}

function formatNumber(value?: number): string {
  return value == null ? '—' : value.toLocaleString();
}
---

{
  hasMetadata && (
    <section class="model-meta" aria-label={title}>
      <div class="model-meta__header">
        <h2 class="model-meta__title">{title}</h2>
        {meta.provider && <span class="model-meta__badge">{meta.provider}</span>}
      </div>

      <div class="model-meta__grid">
        <div class="model-meta__item">
          <span class="model-meta__label">Model</span>
          <span class="model-meta__value model-meta__value--mono">{meta.model ?? '—'}</span>
        </div>
        <div class="model-meta__item">
          <span class="model-meta__label">Latency</span>
          <span class="model-meta__value">{formatDuration(meta.durationMs)}</span>
        </div>
        <div class="model-meta__item">
          <span class="model-meta__label">Prompt tokens</span>
          <span class="model-meta__value">{formatNumber(meta.promptTokens)}</span>
        </div>
        <div class="model-meta__item">
          <span class="model-meta__label">Completion tokens</span>
          <span class="model-meta__value">{formatNumber(meta.completionTokens)}</span>
        </div>
      </div>

      {(meta.promptTokens != null || meta.completionTokens != null) && (
        <div class="model-meta__tokens" aria-label="Token usage">
          <div class="model-meta__token-bar">
            <span
              class="model-meta__token model-meta__token--prompt"
              style={`flex-grow: ${meta.promptTokens ?? 0}`}
            />
            <span
              class="model-meta__token model-meta__token--completion"
              style={`flex-grow: ${meta.completionTokens ?? 0}`}
            />
          </div>
          <span class="model-meta__token-total">{formatNumber(totalTokens)} total tokens</span>
        </div>
      )}
    </section>
  )
}

<style>
  .model-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    padding: var(--space-4);
  }

  .model-meta__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .model-meta__title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text);
  }

  .model-meta__badge {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.125rem 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .model-meta__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: var(--space-3);
  }

  .model-meta__item {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--space-1);
  }

  .model-meta__label {
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  .model-meta__value {
    overflow-wrap: anywhere;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text);
  }

  .model-meta__value--mono {
    font-family: var(--font-mono);
  }

  .model-meta__tokens {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .model-meta__token-bar {
    display: flex;
    height: 0.5rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--bg-subtle);
  }

  .model-meta__token {
    min-width: 0.125rem;
  }

  .model-meta__token--prompt {
    background: var(--accent);
  }

  .model-meta__token--completion {
    background: var(--primary);
  }

  .model-meta__token-total {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
</style>
