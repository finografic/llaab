---
/**
 * PageHero — page-level header / hero zone.
 *
 * Slots:
 *   actions     — right-side buttons (default slot on the actions side)
 *   description — optional subtitle below the title row
 *   meta        — optional row of stats/badges below description
 *
 * Props:
 *   eyebrow  — small label above the title (e.g. section name, breadcrumb)
 *   title    — main page heading (h1)
 *   bordered — show bottom border (default true)
 */

interface Props {
  eyebrow?: string;
  title: string;
  bordered?: boolean;
}

const { eyebrow, title, bordered = true } = Astro.props;
---

<header class="page-hero" data-bordered={bordered || undefined}>
  <div class="page-hero__inner">
    <div class="page-hero__text">
      {eyebrow && <p class="eyebrow page-hero__eyebrow">{eyebrow}</p>}

      <div class="page-hero__title-row">
        <h1 class="page-hero__title">{title}</h1>

        {
          Astro.slots.has('actions') && (
            <div class="page-hero__actions">
              <slot name="actions" />
            </div>
          )
        }
      </div>

      {
        Astro.slots.has('description') && (
          <p class="page-hero__description">
            <slot name="description" />
          </p>
        )
      }
    </div>
  </div>

  {
    Astro.slots.has('meta') && (
      <div class="page-hero__meta">
        <slot name="meta" />
      </div>
    )
  }
</header>

<style>
  .page-hero {
    flex-shrink: 0;
    margin-bottom: var(--space-4);
  }

  .page-hero[data-bordered] {
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--border-subtle);
  }

  .page-hero__inner {
    padding: 0 0 var(--space-2);
  }

  /* ─── Eyebrow ────────────────────────────────────────────────── */

  .page-hero__eyebrow {
    margin-bottom: var(--space-1);
  }

  /* ─── Title row ──────────────────────────────────────────────── */

  .page-hero__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .page-hero__title {
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--text);
    margin: 0;
  }

  /* ─── Actions ────────────────────────────────────────────────── */

  .page-hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  /* ─── Description ────────────────────────────────────────────── */

  .page-hero__description {
    margin-top: var(--space-1);
    font-size: var(--text-ui);
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* ─── Meta row ───────────────────────────────────────────────── */

  .page-hero__meta {
    padding: var(--space-1) 0 var(--space-3);
    background: var(--bg);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--text-base);
    color: var(--text-faint);
  }
</style>
