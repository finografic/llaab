---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { Button } from 'components/ui/button';
import { Input } from 'components/ui/input';

const COOKIE_NAME = 'vault_key';
const COOKIE_MAX_AGE = 60 * 60 * 24 * 30;
const vaultPassword = import.meta.env.VAULT_PASSWORD ?? 'llaab';

let hasError = Astro.url.searchParams.has('error');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const submitted = form.get('password');

  if (typeof submitted === 'string' && submitted === vaultPassword) {
    Astro.cookies.set(COOKIE_NAME, vaultPassword, {
      path: '/',
      maxAge: COOKIE_MAX_AGE,
      httpOnly: true,
      sameSite: 'lax',
    });
    return Astro.redirect('/vault', 302);
  }

  hasError = true;
}
---

<BaseLayout title="Vault — LLAAB">
  <div class="page-wrap">
    <main>
      <p class="eyebrow">LLAAB</p>
      <h1>Vault</h1>

      <div class="card">
        <form method="POST">
          <div class="flex flex-col gap-1.5">
            <label for="password" class="text-xs font-medium uppercase tracking-wide text-muted-foreground"
              >Password</label
            >
            <div class="flex gap-2 items-center">
              <Input
                id="password"
                name="password"
                type="password"
                autoComplete="current-password"
                autoFocus
                placeholder="Enter vault password"
                className="font-mono text-sm"
              />
              <Button type="submit">Unlock</Button>
            </div>
            {hasError && <span class="text-sm text-destructive">Incorrect password.</span>}
          </div>
        </form>

        <p class="hint">
          Default password is <code>llaab</code>. Override with
          <code>VAULT_PASSWORD</code> in <code>.env</code>.
        </p>
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .page-wrap {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 64px 16px;
    min-height: 100vh;
  }

  main {
    width: 100%;
    max-width: 400px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  h1 {
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .hint {
    margin-top: 16px;
    font-size: var(--text-md);
    color: var(--text-muted);
    line-height: 1.6;
  }

  code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 1px 5px;
  }
</style>
