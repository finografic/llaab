---
export const prerender = false;

import { listNodes } from '@llaab/core';
import type { IdeaNode, InstructionNode, PromptNode, ResourceNode, SkillNode } from '@llaab/schemas';
import ModelMetaCard from 'components/ModelMetaCard.astro';
import AppLayout from 'layouts/AppLayout.astro';
import PageLayout from 'layouts/PageLayout.astro';
import PageHero from 'components/PageHero/PageHero.astro';

// ── Auth gate ─────────────────────────────────────────────────────────────────

const COOKIE_NAME = 'vault_key';
const password = import.meta.env.VAULT_PASSWORD ?? 'llaab';
const cookie = Astro.cookies.get(COOKIE_NAME);
if (cookie?.value !== password) return Astro.redirect('/vault/login', 302);

// ── Data ──────────────────────────────────────────────────────────────────────

const { id } = Astro.params;
const all = await listNodes();
const node = all.find((n) => n.id === id);

if (!node) return Astro.redirect('/vault/nodes', 302);

function fmtDate(ts?: string): string {
  if (!ts) return '—';
  return new Date(ts).toLocaleString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}

// Type-narrowed node views
const idea = node.type === 'idea' ? (node as IdeaNode) : null;
const skill = node.type === 'skill' ? (node as SkillNode) : null;
const prompt = node.type === 'prompt' ? (node as PromptNode) : null;
const instruction = node.type === 'instruction' ? (node as InstructionNode) : null;
const resource = node.type === 'resource' ? (node as ResourceNode) : null;
---

<AppLayout title={node.title}>
  <PageLayout>
    <PageHero slot="hero" eyebrow="Vault" title={node.title}>
      <Fragment slot="meta">
        <span class={`badge badge--${node.type}`}>{node.type}</span>
        <span class={`badge badge--status badge--${node.status}`}>{node.status}</span>
        <span class="meta-sep">·</span>
        <span class="meta-text">{fmtDate(node.created_at)}</span>
        {
          node.updated_at && node.updated_at !== node.created_at && (
            <>
              <span class="meta-sep">·</span>
              <span class="meta-text">updated {fmtDate(node.updated_at)}</span>
            </>
          )
        }
      </Fragment>
    </PageHero>

    <div class="detail-page">
      {/* ── Tags ── */}
      {
        node.tags.length > 0 && (
          <div class="tag-row">
            {node.tags.map((tag) => (
              <span class="tag" data-tag={tag}>
                {tag}
              </span>
            ))}
          </div>
        )
      }

      {/* ── Body ── */}
      {
        idea && (
          <ModelMetaCard
            title="Extraction model"
            meta={{
              model: idea.llm_model,
              provider: idea.llm_provider,
              durationMs: idea.llm_duration_ms,
              promptTokens: idea.llm_prompt_tokens,
              completionTokens: idea.llm_completion_tokens,
            }}
          />
        )
      }

      {
        node.body && (
          <section class="section">
            <h2 class="section__heading">Body</h2>
            <pre class="body-pre">{node.body}</pre>
          </section>
        )
      }

      {/* ── Idea — origin + source ── */}
      {
        idea && (
          <section class="section">
            <h2 class="section__heading">Details</h2>
            <dl class="meta-grid">
              <dt>Origin</dt>
              <dd>
                <span class={`badge badge--origin-${idea.origin}`}>{idea.origin}</span>
              </dd>
              {idea.source_id && (
                <>
                  <dt>Source</dt>
                  <dd>
                    <a href={`/vault/nodes/${idea.source_id}`} class="meta-link">
                      {idea.source_id}
                    </a>
                  </dd>
                </>
              )}
            </dl>
          </section>
        )
      }

      {/* ── Resource — url + resource_type + description ── */}
      {
        resource && (
          <section class="section">
            <h2 class="section__heading">Details</h2>
            <dl class="meta-grid">
              <dt>Type</dt>
              <dd>
                <span class="badge badge--resource-type">{resource.resource_type}</span>
              </dd>
              {resource.url && (
                <>
                  <dt>URL</dt>
                  <dd>
                    <a
                      href={resource.url}
                      class="meta-link meta-mono"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {resource.url}
                    </a>
                  </dd>
                </>
              )}
              {resource.description && (
                <>
                  <dt>Description</dt>
                  <dd class="meta-text">{resource.description}</dd>
                </>
              )}
              {resource.source_id && (
                <>
                  <dt>Source</dt>
                  <dd>
                    <a href={`/vault/nodes/${resource.source_id}`} class="meta-link">
                      {resource.source_id}
                    </a>
                  </dd>
                </>
              )}
            </dl>
          </section>
        )
      }

      {/* ── Skill — inputs / outputs / tools / lineage ── */}
      {
        skill && (
          <section class="section">
            <h2 class="section__heading">Details</h2>
            <dl class="meta-grid">
              {skill.version && (
                <>
                  <dt>Version</dt>
                  <dd class="meta-mono">{skill.version}</dd>
                </>
              )}
              <dt>Generation</dt>
              <dd class="meta-mono">{skill.generation}</dd>
              {skill.inputs.length > 0 && (
                <>
                  <dt>Inputs</dt>
                  <dd>
                    <ul class="chip-list">
                      {skill.inputs.map((s) => (
                        <li class="chip">{s}</li>
                      ))}
                    </ul>
                  </dd>
                </>
              )}
              {skill.outputs.length > 0 && (
                <>
                  <dt>Outputs</dt>
                  <dd>
                    <ul class="chip-list">
                      {skill.outputs.map((s) => (
                        <li class="chip">{s}</li>
                      ))}
                    </ul>
                  </dd>
                </>
              )}
              {skill.tools.length > 0 && (
                <>
                  <dt>Tools</dt>
                  <dd>
                    <ul class="chip-list">
                      {skill.tools.map((s) => (
                        <li class="chip">{s}</li>
                      ))}
                    </ul>
                  </dd>
                </>
              )}
              {skill.source_id && (
                <>
                  <dt>Source</dt>
                  <dd>
                    <a href={`/vault/nodes/${skill.source_id}`} class="meta-link">
                      {skill.source_id}
                    </a>
                  </dd>
                </>
              )}
              {skill.parent_skill_id && (
                <>
                  <dt>Parent skill</dt>
                  <dd>
                    <a href={`/vault/nodes/${skill.parent_skill_id}`} class="meta-link">
                      {skill.parent_skill_id}
                    </a>
                  </dd>
                </>
              )}
              {skill.derived_from_ids.length > 0 && (
                <>
                  <dt>Derived from</dt>
                  <dd>
                    <ul class="chip-list">
                      {skill.derived_from_ids.map((sid) => (
                        <li class="chip">
                          <a href={`/vault/nodes/${sid}`} class="meta-link">
                            {sid}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </dd>
                </>
              )}
            </dl>
          </section>
        )
      }

      {/* ── Prompt — variables / model_hint / output_schema ── */}
      {
        prompt && (prompt.variables.length > 0 || prompt.model_hint || prompt.output_schema) && (
          <section class="section">
            <h2 class="section__heading">Details</h2>
            <dl class="meta-grid">
              {prompt.model_hint && (
                <>
                  <dt>Model hint</dt>
                  <dd class="meta-mono">{prompt.model_hint}</dd>
                </>
              )}
              {prompt.variables.length > 0 && (
                <>
                  <dt>Variables</dt>
                  <dd>
                    <ul class="chip-list">
                      {prompt.variables.map((v) => (
                        <li class="chip chip--var">{`{{${v}}}`}</li>
                      ))}
                    </ul>
                  </dd>
                </>
              )}
              {prompt.output_schema && (
                <>
                  <dt>Output schema</dt>
                  <dd class="meta-mono">{prompt.output_schema}</dd>
                </>
              )}
            </dl>
          </section>
        )
      }

      {/* ── Instruction — scope ── */}
      {
        instruction && instruction.scope && (
          <section class="section">
            <h2 class="section__heading">Details</h2>
            <dl class="meta-grid">
              <dt>Scope</dt>
              <dd class="meta-text">{instruction.scope}</dd>
            </dl>
          </section>
        )
      }

      {/* ── Related nodes ── */}
      {
        node.related.length > 0 && (
          <section class="section">
            <h2 class="section__heading">Related</h2>
            <ul class="related-list">
              {node.related.map((rel) => (
                <li>
                  <a href={`/vault/nodes/${rel}`} class="meta-link meta-mono">
                    {rel}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </PageLayout>
</AppLayout>

<style>
  .detail-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 760px;
  }

  .meta-sep {
    color: var(--text-faint);
  }

  .meta-text {
    font-size: var(--text-md);
    color: var(--text-faint);
  }

  .meta-mono {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    color: var(--text-muted);
  }

  .meta-link {
    color: var(--accent);
    text-decoration: none;
    font-size: var(--text-md);
  }

  .meta-link:hover {
    text-decoration: underline;
  }

  /* ── Sections ── */

  .section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .section__heading {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-subtle);
  }

  /* ── Meta grid (key/value) ── */

  .meta-grid {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-base);
  }

  .meta-grid dt {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-top: 2px;
    white-space: nowrap;
  }

  .meta-grid dd {
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* ── Body pre ── */

  .body-pre {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    line-height: 1.7;
    white-space: pre-wrap;
    word-break: break-word;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-4);
    color: var(--text-muted);
  }

  /* ── Chip list ── */

  .chip-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .chip {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-faint);
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: 1px 6px;
  }

  .chip--var {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
  }

  /* ── Related list ── */

  .related-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  /* ── Node badge variants (base in app.css) ── */

  .badge--idea {
    background: oklch(0.22 0.04 264 / 0.25);
    color: oklch(0.65 0.18 264);
    border-color: oklch(0.4 0.12 264 / 0.4);
  }
  .badge--resource {
    background: oklch(0.22 0.04 155 / 0.25);
    color: oklch(0.6 0.17 155);
    border-color: oklch(0.4 0.12 155 / 0.4);
  }
  .badge--prompt {
    background: oklch(0.24 0.05 40 / 0.25);
    color: oklch(0.7 0.19 40);
    border-color: oklch(0.42 0.12 40 / 0.4);
  }
  .badge--skill {
    background: oklch(0.22 0.04 295 / 0.25);
    color: oklch(0.65 0.18 295);
    border-color: oklch(0.4 0.12 295 / 0.4);
  }
  .badge--instruction {
    background: oklch(0.24 0.05 80 / 0.25);
    color: oklch(0.77 0.16 80);
    border-color: oklch(0.44 0.14 80 / 0.4);
  }
  .badge--status {
    border-radius: 4px;
  }
  .badge--seed {
    background: var(--surface-raised);
    color: var(--text-faint);
    border-color: var(--border-subtle);
  }
  .badge--growing {
    background: oklch(0.24 0.05 40 / 0.25);
    color: oklch(0.7 0.19 40);
    border-color: oklch(0.42 0.12 40 / 0.4);
  }
  .badge--mature {
    background: oklch(0.22 0.04 155 / 0.25);
    color: oklch(0.6 0.17 155);
    border-color: oklch(0.4 0.12 155 / 0.4);
  }
  .badge--archived {
    background: var(--surface-raised);
    color: var(--text-faint);
    border-color: var(--border-subtle);
    opacity: 0.6;
  }
  .badge--origin-manual {
    background: var(--surface-raised);
    color: var(--text-muted);
    border-color: var(--border-subtle);
  }
  .badge--origin-extracted {
    background: oklch(0.22 0.04 264 / 0.25);
    color: oklch(0.65 0.18 264);
    border-color: oklch(0.4 0.12 264 / 0.4);
  }
  .badge--origin-generated {
    background: oklch(0.22 0.04 295 / 0.25);
    color: oklch(0.65 0.18 295);
    border-color: oklch(0.4 0.12 295 / 0.4);
  }
  .badge--resource-type {
    background: var(--surface-raised);
    color: var(--text-muted);
    border-color: var(--border-subtle);
    border-radius: 4px;
  }
</style>
