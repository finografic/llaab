---
export const prerender = false;

import { listNodes } from '@llaab/core';
import type { LabNode } from '@llaab/schemas';
import AppLayout from 'layouts/AppLayout.astro';
import PageLayout from 'layouts/PageLayout.astro';
import PageHero from 'components/PageHero/PageHero.astro';
import { CreateIdeaPanel } from 'components/CreateIdeaPanel';
import { NodesFileList } from 'components/NodesFileList/NodesFileList';

// ── Auth gate ─────────────────────────────────────────────────────────────────

const COOKIE_NAME = 'vault_key';
const password = import.meta.env.VAULT_PASSWORD ?? 'llaab';
const cookie = Astro.cookies.get(COOKIE_NAME);
if (cookie?.value !== password) return Astro.redirect('/vault/login', 302);

// ── Data ──────────────────────────────────────────────────────────────────────

const CONTENT_TYPES = ['idea', 'resource', 'prompt', 'skill', 'instruction'] as const;

const all = await listNodes();
const nodes: LabNode[] = all
  .filter((n) => (CONTENT_TYPES as readonly string[]).includes(n.type))
  .sort((a, b) => b.created_at.localeCompare(a.created_at));
---

<AppLayout title="Nodes">
  <PageLayout>
    <PageHero slot="hero" eyebrow="Vault" title="Nodes">
      <Fragment slot="meta">
        <span>{nodes.length} node{nodes.length !== 1 ? 's' : ''}</span>
        {
          Object.entries(Object.groupBy(nodes, (n) => n.type)).map(([type, items]) => (
            <span>
              {type} · {items?.length ?? 0}
            </span>
          ))
        }
      </Fragment>
      <CreateIdeaPanel slot="actions" client:only="react" />
    </PageHero>

    {
      nodes.length === 0 ? (
        <p class="empty">No nodes yet. Use the button above or ingest a video to get started.</p>
      ) : (
        <NodesFileList client:only="react" nodes={nodes} />
      )
    }
  </PageLayout>
</AppLayout>

<style>
  .empty {
    padding: var(--space-6);
    font-size: var(--text-base);
    color: var(--text-muted);
  }
</style>
