---
export const prerender = false;

import { listNodes } from '@llaab/core';
import type { TranscriptNode } from '@llaab/schemas';
import AppLayout from '../../../layouts/AppLayout.astro';

// ── Auth gate ─────────────────────────────────────────────────────────────────

const COOKIE_NAME = 'vault_key';
const password = import.meta.env.VAULT_PASSWORD ?? 'llaab';
const cookie = Astro.cookies.get(COOKIE_NAME);
if (cookie?.value !== password) return Astro.redirect('/vault/login', 302);

// ── Data ──────────────────────────────────────────────────────────────────────

const all = await listNodes({ type: 'transcript' });
const transcripts = all as TranscriptNode[];
transcripts.sort((a, b) => b.createdAt.localeCompare(a.createdAt));
---

<AppLayout title="Transcripts">
  <div class="list-page">
    <header class="list-page__header">
      <p class="eyebrow">Vault</p>
      <h1 class="list-page__heading">Transcripts</h1>
      <p class="list-page__count">{transcripts.length} transcript{transcripts.length !== 1 ? 's' : ''}</p>
    </header>

    {transcripts.length === 0 && (
      <p class="empty">No transcripts yet. <a href="/ingest">Ingest a YouTube video</a> to get started.</p>
    )}

    <ul class="node-list" role="list">
      {transcripts.map((t) => (
        <li class="node-card">
          <div class="node-card__meta">
            <span class={`badge badge--${t.sourceType}`}>{t.sourceType}</span>
            <time class="node-card__date" datetime={t.createdAt}>
              {new Date(t.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
          </div>

          <h2 class="node-card__title">{t.title}</h2>

          {t.author && <p class="node-card__author">{t.author}</p>}

          {t.summary && <p class="node-card__summary">{t.summary}</p>}

          {t.tags.length > 0 && (
            <div class="tag-row">
              {t.tags.map((tag) => (
                <span class="tag" data-tag={tag}>{tag}</span>
              ))}
            </div>
          )}

          <div class="node-card__stats">
            {t.cleanLength != null && (
              <span class="stat">{t.cleanLength.toLocaleString()} chars</span>
            )}
            {t.structuredParagraphs != null && (
              <span class="stat">{t.structuredParagraphs} §</span>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</AppLayout>

<style>
  .list-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 760px;
  }

  .list-page__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .list-page__heading {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .list-page__count {
    font-size: 12px;
    color: var(--text-faint);
  }

  .empty {
    font-size: 13px;
    color: var(--text-muted);
  }

  .empty a {
    color: var(--accent);
    text-decoration: underline;
  }

  /* ── Node list ── */

  .node-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .node-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .node-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .node-card__title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.4;
  }

  .node-card__author {
    font-size: 12px;
    color: var(--text-muted);
  }

  .node-card__summary {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .node-card__stats {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-1);
  }

  .node-card__date {
    font-size: 11px;
    color: var(--text-faint);
    font-family: var(--font-mono);
  }

  /* ── Badges ── */

  .badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 7px;
    border-radius: 99px;
    font-size: 10px;
    font-weight: 500;
    font-family: var(--font-mono);
    letter-spacing: 0.03em;
    background: var(--surface-raised);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
  }

  .badge--youtube { background: #fef2f2; color: #dc2626; border-color: #fecaca; }
  .badge--article { background: #f0fdf4; color: #16a34a; border-color: #bbf7d0; }
  .badge--repo    { background: #f5f3ff; color: #7c3aed; border-color: #ddd6fe; }
  .badge--chat    { background: #fff7ed; color: #ea580c; border-color: #fed7aa; }
  .badge--other   { background: var(--surface-raised); color: var(--text-muted); border-color: var(--border-subtle); }

  /* ── Tag pills ── */

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: 2px 7px;
    border-radius: 99px;
    font-size: 10px;
    font-family: var(--font-mono);
    font-weight: 500;
    background: color-mix(in srgb, var(--tag-color, var(--accent)) 12%, transparent);
    color: var(--tag-color, var(--accent));
    border: 1px solid color-mix(in srgb, var(--tag-color, var(--accent)) 30%, transparent);
  }

  .tag[data-tag='d:llm']         { --tag-color: #3b82f6; }
  .tag[data-tag='d:automation']  { --tag-color: #8b5cf6; }
  .tag[data-tag='d:ingest']      { --tag-color: #f59e0b; }
  .tag[data-tag='d:schema']      { --tag-color: #14b8a6; }
  .tag[data-tag='d:infra']       { --tag-color: #6b7280; }
  .tag[data-tag='d:integration'] { --tag-color: #f97316; }
  .tag[data-tag='d:ui']          { --tag-color: #ec4899; }
  .tag[data-tag='d:meta']        { --tag-color: #22c55e; }

  /* ── Stats ── */

  .stat {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--text-faint);
  }
</style>
