---
export const prerender = false;

import { listNodes } from '@llaab/core';
import type { TranscriptNode } from '@llaab/schemas';
import AppLayout from 'layouts/AppLayout.astro';
import PageLayout from 'layouts/PageLayout.astro';
import PageList from 'layouts/PageList.astro';
import PageHero from 'components/PageHero/PageHero.astro';
import { TranscriptsTable } from 'components/TranscriptsTable';

// ── Auth gate ─────────────────────────────────────────────────────────────────

const COOKIE_NAME = 'vault_key';
const password = import.meta.env.VAULT_PASSWORD ?? 'llaab';
const cookie = Astro.cookies.get(COOKIE_NAME);
if (cookie?.value !== password) return Astro.redirect('/vault/login', 302);

// ── Data ──────────────────────────────────────────────────────────────────────

const all = await listNodes({ type: 'transcript' });
const transcripts = all as TranscriptNode[];
transcripts.sort((a, b) => b.created_at.localeCompare(a.created_at));
---

<AppLayout title="Transcripts">
  <PageLayout>
    <PageHero slot="hero" eyebrow="Vault" title="Transcripts">
      <Fragment slot="meta">
        {transcripts.length} transcript{transcripts.length !== 1 ? 's' : ''}
      </Fragment>
    </PageHero>

    <PageList width="wide">
      <TranscriptsTable transcripts={transcripts} client:load />
    </PageList>
  </PageLayout>
</AppLayout>
