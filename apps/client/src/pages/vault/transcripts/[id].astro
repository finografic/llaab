---
export const prerender = false;

import { listNodes } from '@llaab/core';
import type { IdeaNode, TranscriptNode } from '@llaab/schemas';
import ModelMetaCard from 'components/ModelMetaCard.astro';
import AppLayout from 'layouts/AppLayout.astro';
import PageLayout from 'layouts/PageLayout.astro';
import PageDetail from 'layouts/PageDetail.astro';
import PageHero from 'components/PageHero/PageHero.astro';

// ── Auth gate ─────────────────────────────────────────────────────────────────

const COOKIE_NAME = 'vault_key';
const password = import.meta.env.VAULT_PASSWORD ?? 'llaab';
const cookie = Astro.cookies.get(COOKIE_NAME);
if (cookie?.value !== password) return Astro.redirect('/vault/login', 302);

// ── Data ──────────────────────────────────────────────────────────────────────

const { id } = Astro.params;
const all = await listNodes({ type: 'transcript' });
const transcript = (all as TranscriptNode[]).find((t) => t.id === id);

if (!transcript) return Astro.redirect('/vault/transcripts', 302);

// Load extracted ideas if any exist
let extractedIdeas: IdeaNode[] = [];
if (transcript.extracted_idea_ids.length > 0) {
  const ideaNodes = await listNodes({ type: 'idea' });
  const ideaSet = new Set(transcript.extracted_idea_ids);
  extractedIdeas = (ideaNodes as IdeaNode[]).filter((n) => ideaSet.has(n.id));
}

function fmtDate(ts?: string): string {
  if (!ts) return '—';
  return new Date(ts).toLocaleString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}
---

<AppLayout title={transcript.title}>
  <PageLayout>
    <PageHero slot="hero" eyebrow="Vault" title={transcript.title}>
      <Fragment slot="meta">
        <span class={`badge badge--${transcript.source_type}`}>{transcript.source_type}</span>
        {transcript.author && <span class="meta-text">{transcript.author}</span>}
        <span class="meta-sep">·</span>
        <span class="meta-text">{fmtDate(transcript.created_at)}</span>
      </Fragment>
    </PageHero>

    <PageDetail>
      {/* ── Tags ── */}
      {
        transcript.tags.length > 0 && (
          <div class="tag-row">
            {transcript.tags.map((tag) => (
              <span class="tag" data-tag={tag}>
                {tag}
              </span>
            ))}
          </div>
        )
      }

      {/* ── Source metadata ── */}
      <section class="section">
        <h2 class="section__heading">Source</h2>
        <dl class="meta-grid">
          <dt>URL</dt>
          <dd>
            <a
              href={transcript.source_url}
              class="meta-link meta-mono"
              target="_blank"
              rel="noopener noreferrer"
            >
              {transcript.source_url}
            </a>
          </dd>
          {
            transcript.source_item_id && (
              <>
                <dt>Item ID</dt>
                <dd class="meta-mono">{transcript.source_item_id}</dd>
              </>
            )
          }
          {
            transcript.source_id && (
              <>
                <dt>Source node</dt>
                <dd>
                  <a href={`/vault/sources/${transcript.source_id}`} class="meta-link">
                    {transcript.source_id}
                  </a>
                </dd>
              </>
            )
          }
          {
            (transcript.raw_length != null ||
              transcript.clean_length != null ||
              transcript.structured_paragraphs != null) && (
              <>
                <dt>Stats</dt>
                <dd>
                  <span class="stat-row">
                    {transcript.raw_length != null && (
                      <span class="stat">{transcript.raw_length.toLocaleString()} raw chars</span>
                    )}
                    {transcript.clean_length != null && (
                      <span class="stat">{transcript.clean_length.toLocaleString()} clean chars</span>
                    )}
                    {transcript.structured_paragraphs != null && (
                      <span class="stat">{transcript.structured_paragraphs} §</span>
                    )}
                  </span>
                </dd>
              </>
            )
          }
        </dl>
      </section>

      {/* ── Summary ── */}
      <ModelMetaCard
        title="Extraction model"
        meta={{
          model: transcript.llm_model,
          provider: transcript.llm_provider,
          durationMs: transcript.llm_duration_ms,
          promptTokens: transcript.llm_prompt_tokens,
          completionTokens: transcript.llm_completion_tokens,
        }}
      />

      {
        transcript.summary && (
          <section class="section">
            <h2 class="section__heading">Summary</h2>
            <p class="summary-text">{transcript.summary}</p>
          </section>
        )
      }

      {/* ── Extracted ideas ── */}
      <section class="section">
        <h2 class="section__heading">
          Extracted ideas
          {
            transcript.extracted_idea_ids.length > 0 && (
              <span class="section__count">{transcript.extracted_idea_ids.length}</span>
            )
          }
          <button
            id="re-extract-btn"
            data-id={transcript.id}
            class="ml-auto cursor-pointer rounded-sm border border-border-subtle px-2.5 py-0.5 font-sans text-[10px] font-medium text-muted-foreground transition hover:border-accent hover:text-accent disabled:cursor-wait disabled:opacity-50"
          >
            {transcript.extracted_idea_ids.length > 0 ? 'Re-extract' : 'Extract now'}
          </button>
          <span id="re-extract-status" class="normal-case text-[11px] font-normal tracking-normal"></span>
        </h2>

        {transcript.extracted_idea_ids.length === 0 && <p class="empty-note">No ideas extracted yet.</p>}
        {
          transcript.extracted_idea_ids.length > 0 && extractedIdeas.length > 0 && (
            <ul class="idea-list">
              {extractedIdeas.map((idea) => (
                <li class="idea-item">
                  <a href={`/vault/nodes/${idea.id}`} class="idea-link">
                    <span class="idea-title">{idea.title}</span>
                    {idea.tags.length > 0 && (
                      <span class="idea-tags">
                        {idea.tags.map((tag) => (
                          <span class="tag tag--sm" data-tag={tag}>
                            {tag}
                          </span>
                        ))}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        {
          transcript.extracted_idea_ids.length > 0 && extractedIdeas.length === 0 && (
            <p class="empty-note">Ideas listed in IDs but nodes not found in vault.</p>
          )
        }
      </section>

      {/* ── Full transcript ── */}
      {
        transcript.body && (
          <section class="section">
            <h2 class="section__heading">Transcript</h2>
            <pre class="body-pre">{transcript.body}</pre>
          </section>
        )
      }
    </PageDetail>
  </PageLayout>
</AppLayout>

<script>
  const btn = document.getElementById('re-extract-btn') as HTMLButtonElement | null;
  const status = document.getElementById('re-extract-status');
  if (btn && status) {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.id;
      btn.disabled = true;
      btn.textContent = 'Extracting…';
      status.textContent = '';
      status.className = 'text-[11px]';
      try {
        const res = await fetch(`/api/vault/transcripts/${id}/extract`, { method: 'POST' });
        const json = (await res.json()) as { success: boolean; ideaIds?: string[]; error?: string };
        if (json.success) {
          status.textContent = `✓ ${json.ideaIds?.length ?? 0} ideas extracted — reloading…`;
          status.className = 'text-[11px] text-emerald-600 dark:text-emerald-400';
          setTimeout(() => location.reload(), 1200);
        } else {
          status.textContent = json.error ?? 'Extraction failed';
          status.className = 'text-[11px] text-destructive';
          btn.disabled = false;
          btn.textContent = 'Retry';
        }
      } catch {
        status.textContent = 'Network error';
        status.className = 'text-[11px] text-destructive';
        btn.disabled = false;
        btn.textContent = 'Retry';
      }
    });
  }
</script>

<style>
  .stat-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .stat {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--text-faint);
  }

  /* ── Extracted ideas ── */

  .idea-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .idea-item {
    border-radius: var(--radius);
    transition: background var(--duration) var(--ease);
  }

  .idea-item:hover {
    background: var(--surface-raised);
  }

  .idea-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    text-decoration: none;
    color: inherit;
  }

  .idea-title {
    font-size: var(--text-base);
    color: var(--text);
    line-height: 1.4;
    flex: 1;
  }

  .idea-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    flex-shrink: 0;
  }

  .empty-note {
    font-size: var(--text-md);
    color: var(--text-faint);
  }

  /* ── Body pre ── */

  .body-pre {
    max-height: 480px;
    overflow-y: auto;
  }

  /* ── Source type badge variants (base in app.css) ── */

  .badge--youtube {
    background: oklch(0.22 0.04 25 / 0.25);
    color: oklch(0.68 0.2 25);
    border-color: oklch(0.42 0.12 25 / 0.4);
  }
  .badge--article {
    background: oklch(0.22 0.04 155 / 0.25);
    color: oklch(0.6 0.17 155);
    border-color: oklch(0.4 0.12 155 / 0.4);
  }
  .badge--repo {
    background: oklch(0.22 0.04 295 / 0.25);
    color: oklch(0.65 0.18 295);
    border-color: oklch(0.4 0.12 295 / 0.4);
  }
  .badge--chat {
    background: oklch(0.24 0.05 40 / 0.25);
    color: oklch(0.7 0.19 40);
    border-color: oklch(0.42 0.12 40 / 0.4);
  }
</style>
