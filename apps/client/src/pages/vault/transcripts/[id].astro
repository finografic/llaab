---
export const prerender = false;

import { listNodes } from '@llaab/core';
import type { IdeaNode, TranscriptNode } from '@llaab/schemas';
import AppLayout from '../../../layouts/AppLayout.astro';

// ── Auth gate ─────────────────────────────────────────────────────────────────

const COOKIE_NAME = 'vault_key';
const password = import.meta.env.VAULT_PASSWORD ?? 'llaab';
const cookie = Astro.cookies.get(COOKIE_NAME);
if (cookie?.value !== password) return Astro.redirect('/vault/login', 302);

// ── Data ──────────────────────────────────────────────────────────────────────

const { id } = Astro.params;
const all = await listNodes({ type: 'transcript' });
const transcript = (all as TranscriptNode[]).find((t) => t.id === id);

if (!transcript) return Astro.redirect('/vault/transcripts', 302);

// Load extracted ideas if any exist
let extractedIdeas: IdeaNode[] = [];
if (transcript.extracted_idea_ids.length > 0) {
  const ideaNodes = await listNodes({ type: 'idea' });
  const ideaSet = new Set(transcript.extracted_idea_ids);
  extractedIdeas = (ideaNodes as IdeaNode[]).filter((n) => ideaSet.has(n.id));
}

function fmtDate(ts?: string): string {
  if (!ts) return '—';
  return new Date(ts).toLocaleString('en-US', {
    year: 'numeric', month: 'short', day: 'numeric',
    hour: '2-digit', minute: '2-digit',
  });
}

function fmtSeconds(s?: number): string {
  if (s == null) return '—';
  const m = Math.floor(s / 60);
  const sec = s % 60;
  return m > 0 ? `${m}m ${sec}s` : `${sec}s`;
}
---

<AppLayout title={transcript.title}>
  <div class="detail-page">

    {/* ── Header ── */}
    <header class="detail-header">
      <nav class="breadcrumb">
        <a href="/vault/transcripts" class="breadcrumb__link">Transcripts</a>
        <span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">{transcript.title}</span>
      </nav>

      <h1 class="detail-header__title">{transcript.title}</h1>

      <div class="detail-header__meta">
        <span class={`badge badge--${transcript.source_type}`}>{transcript.source_type}</span>
        {transcript.author && (
          <span class="meta-text">{transcript.author}</span>
        )}
        <span class="meta-sep">·</span>
        <span class="meta-text">{fmtDate(transcript.created_at)}</span>
      </div>
    </header>

    {/* ── Tags ── */}
    {transcript.tags.length > 0 && (
      <div class="tag-row">
        {transcript.tags.map((tag) => (
          <span class="tag" data-tag={tag}>{tag}</span>
        ))}
      </div>
    )}

    {/* ── Source metadata ── */}
    <section class="section">
      <h2 class="section__heading">Source</h2>
      <dl class="meta-grid">
        <dt>URL</dt>
        <dd>
          <a href={transcript.source_url} class="meta-link meta-mono" target="_blank" rel="noopener noreferrer">
            {transcript.source_url}
          </a>
        </dd>
        {transcript.source_item_id && (
          <>
            <dt>Item ID</dt>
            <dd class="meta-mono">{transcript.source_item_id}</dd>
          </>
        )}
        {transcript.source_id && (
          <>
            <dt>Source node</dt>
            <dd>
              <a href={`/vault/sources/${transcript.source_id}`} class="meta-link">{transcript.source_id}</a>
            </dd>
          </>
        )}
        {(transcript.raw_length != null || transcript.clean_length != null || transcript.structured_paragraphs != null) && (
          <>
            <dt>Stats</dt>
            <dd>
              <span class="stat-row">
                {transcript.raw_length != null && <span class="stat">{transcript.raw_length.toLocaleString()} raw chars</span>}
                {transcript.clean_length != null && <span class="stat">{transcript.clean_length.toLocaleString()} clean chars</span>}
                {transcript.structured_paragraphs != null && <span class="stat">{transcript.structured_paragraphs} §</span>}
              </span>
            </dd>
          </>
        )}
      </dl>
    </section>

    {/* ── Summary ── */}
    {transcript.summary && (
      <section class="section">
        <h2 class="section__heading">Summary</h2>
        <p class="summary-text">{transcript.summary}</p>
      </section>
    )}

    {/* ── Extracted ideas ── */}
    <section class="section">
      <h2 class="section__heading">
        Extracted ideas
        {transcript.extracted_idea_ids.length > 0 && (
          <span class="section__count">{transcript.extracted_idea_ids.length}</span>
        )}
        <button id="re-extract-btn" data-id={transcript.id} class="btn-reextract">
          {transcript.extracted_idea_ids.length > 0 ? 'Re-extract' : 'Extract now'}
        </button>
        <span id="re-extract-status" class="reextract-status"></span>
      </h2>

      {transcript.extracted_idea_ids.length === 0 && (
        <p class="empty-note">No ideas extracted yet.</p>
      )}
      {transcript.extracted_idea_ids.length > 0 && extractedIdeas.length > 0 && (
        <ul class="idea-list">
          {extractedIdeas.map((idea) => (
            <li class="idea-item">
              <a href={`/vault/nodes/${idea.id}`} class="idea-link">
                <span class="idea-title">{idea.title}</span>
                {idea.tags.length > 0 && (
                  <span class="idea-tags">
                    {idea.tags.map((tag) => (
                      <span class="tag tag--sm" data-tag={tag}>{tag}</span>
                    ))}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      )}
      {transcript.extracted_idea_ids.length > 0 && extractedIdeas.length === 0 && (
        <p class="empty-note">Ideas listed in IDs but nodes not found in vault.</p>
      )}
    </section>

    {/* ── Full transcript ── */}
    {transcript.body && (
      <section class="section">
        <h2 class="section__heading">Transcript</h2>
        <pre class="body-pre">{transcript.body}</pre>
      </section>
    )}

  </div>
</AppLayout>

<script>
  const btn = document.getElementById('re-extract-btn') as HTMLButtonElement | null;
  const status = document.getElementById('re-extract-status');
  if (btn && status) {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.id;
      btn.disabled = true;
      btn.textContent = 'Extracting…';
      status.textContent = '';
      status.className = 'reextract-status';
      try {
        const res = await fetch(`/api/vault/transcripts/${id}/extract`, { method: 'POST' });
        const json = await res.json() as { success: boolean; ideaIds?: string[]; error?: string };
        if (json.success) {
          status.textContent = `✓ ${json.ideaIds?.length ?? 0} ideas extracted — reloading…`;
          status.className = 'reextract-status reextract-status--ok';
          setTimeout(() => location.reload(), 1200);
        } else {
          status.textContent = json.error ?? 'Extraction failed';
          status.className = 'reextract-status reextract-status--err';
          btn.disabled = false;
          btn.textContent = 'Retry';
        }
      } catch {
        status.textContent = 'Network error';
        status.className = 'reextract-status reextract-status--err';
        btn.disabled = false;
        btn.textContent = 'Retry';
      }
    });
  }
</script>

<style>
  .detail-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 820px;
  }

  /* ── Header ── */

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 12px;
    color: var(--text-faint);
    margin-bottom: var(--space-2);
  }

  .breadcrumb__link { color: var(--accent); text-decoration: none; }
  .breadcrumb__link:hover { text-decoration: underline; }
  .breadcrumb__sep { color: var(--text-faint); }
  .breadcrumb__current { color: var(--text-muted); }

  .detail-header__title {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
    line-height: 1.3;
  }

  .detail-header__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  .meta-sep { color: var(--text-faint); }
  .meta-text { font-size: 12px; color: var(--text-faint); }
  .meta-mono { font-family: var(--font-mono); font-size: 12px; color: var(--text-muted); }

  .meta-link {
    color: var(--accent);
    text-decoration: none;
    font-size: 12px;
  }
  .meta-link:hover { text-decoration: underline; }

  /* ── Sections ── */

  .section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .section__heading {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section__count {
    font-size: 10px;
    font-family: var(--font-mono);
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: 99px;
    padding: 1px 6px;
    color: var(--text-faint);
    text-transform: none;
    letter-spacing: 0;
    font-weight: 500;
  }

  /* ── Meta grid ── */

  .meta-grid {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-5);
    font-size: 13px;
  }

  .meta-grid dt {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-top: 2px;
    white-space: nowrap;
  }

  .meta-grid dd { color: var(--text-muted); line-height: 1.5; }

  .stat-row { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  .stat {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--text-faint);
  }

  /* ── Summary ── */

  .summary-text {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* ── Extracted ideas ── */

  .idea-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .idea-item {
    border-radius: var(--radius);
    transition: background var(--duration) var(--ease);
  }

  .idea-item:hover { background: var(--surface-raised); }

  .idea-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    text-decoration: none;
    color: inherit;
  }

  .idea-title {
    font-size: 13px;
    color: var(--text);
    line-height: 1.4;
    flex: 1;
  }

  .idea-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    flex-shrink: 0;
  }

  .empty-note {
    font-size: 12px;
    color: var(--text-faint);
  }

  /* ── Body pre ── */

  .body-pre {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.7;
    white-space: pre-wrap;
    word-break: break-word;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-4);
    color: var(--text-muted);
    max-height: 480px;
    overflow-y: auto;
  }

  /* ── Tags ── */

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: 2px 7px;
    border-radius: 99px;
    font-size: 10px;
    font-family: var(--font-mono);
    font-weight: 500;
    background: color-mix(in srgb, var(--tag-color, var(--accent)) 12%, transparent);
    color: var(--tag-color, var(--accent));
    border: 1px solid color-mix(in srgb, var(--tag-color, var(--accent)) 30%, transparent);
  }

  .tag--sm { font-size: 9px; padding: 1px 5px; }

  .tag[data-tag='d:llm']         { --tag-color: #3b82f6; }
  .tag[data-tag='d:automation']  { --tag-color: #8b5cf6; }
  .tag[data-tag='d:ingest']      { --tag-color: #f59e0b; }
  .tag[data-tag='d:schema']      { --tag-color: #14b8a6; }
  .tag[data-tag='d:infra']       { --tag-color: #6b7280; }
  .tag[data-tag='d:integration'] { --tag-color: #f97316; }
  .tag[data-tag='d:ui']          { --tag-color: #ec4899; }
  .tag[data-tag='d:meta']        { --tag-color: #22c55e; }

  /* ── Re-extract ── */

  .btn-reextract {
    margin-left: auto;
    padding: 2px 10px;
    font-size: 10px;
    font-weight: 500;
    font-family: var(--font-sans);
    letter-spacing: 0.02em;
    background: transparent;
    color: var(--text-faint);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: color var(--duration) var(--ease), border-color var(--duration) var(--ease);
    text-transform: none;
  }

  .btn-reextract:hover:not(:disabled) {
    color: var(--accent);
    border-color: var(--accent);
  }

  .btn-reextract:disabled {
    opacity: 0.5;
    cursor: wait;
  }

  .reextract-status {
    font-size: 11px;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
  }

  .reextract-status--ok  { color: var(--success-text); }
  .reextract-status--err { color: var(--error-text); }

  /* ── Badges ── */

  .badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 7px;
    border-radius: 99px;
    font-size: 10px;
    font-weight: 500;
    font-family: var(--font-mono);
    letter-spacing: 0.03em;
    background: var(--surface-raised);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
  }

  .badge--youtube { background: oklch(0.22 0.04 25 / 0.25);  color: oklch(0.68 0.20 25);  border-color: oklch(0.42 0.12 25 / 0.40);  }
  .badge--article { background: oklch(0.22 0.04 155 / 0.25); color: oklch(0.60 0.17 155); border-color: oklch(0.40 0.12 155 / 0.40); }
  .badge--repo    { background: oklch(0.22 0.04 295 / 0.25); color: oklch(0.65 0.18 295); border-color: oklch(0.40 0.12 295 / 0.40); }
  .badge--chat    { background: oklch(0.24 0.05 40 / 0.25);  color: oklch(0.70 0.19 40);  border-color: oklch(0.42 0.12 40 / 0.40);  }
  .badge--other   { background: var(--surface-raised); color: var(--text-muted); border-color: var(--border-subtle); }
</style>
