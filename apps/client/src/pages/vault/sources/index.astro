---
export const prerender = false;

import { listNodes } from '@llaab/core';
import type { SourceNode } from '@llaab/schemas';
import AppLayout from 'layouts/AppLayout.astro';
import PageLayout from 'layouts/PageLayout.astro';
import PageList from 'layouts/PageList.astro';
import PageHero from 'components/PageHero/PageHero.astro';
import { SourcesTable } from '../../../tables/SourcesTable';

// ── Auth gate ─────────────────────────────────────────────────────────────────

const COOKIE_NAME = 'vault_key';
const password = import.meta.env.VAULT_PASSWORD ?? 'llaab';
const cookie = Astro.cookies.get(COOKIE_NAME);
if (cookie?.value !== password) return Astro.redirect('/vault/login', 302);

// ── Data ──────────────────────────────────────────────────────────────────────

const all = await listNodes({ type: 'source' });
const sources = all as SourceNode[];
sources.sort((a, b) => a.title.localeCompare(b.title));

const followed = sources.filter((s) => s.follow);
---

<AppLayout title="Sources">
  <PageLayout>
    <PageHero slot="hero" eyebrow="Vault" title="Sources">
      <Fragment slot="meta">
        {sources.length} source{sources.length !== 1 ? 's' : ''}
        {followed.length > 0 && <span class="follow-count"> · {followed.length} followed</span>}
      </Fragment>
    </PageHero>

    <PageList width="wide">
      <SourcesTable sources={sources} client:load />
    </PageList>
  </PageLayout>
</AppLayout>

<style>
  .follow-count {
    color: oklch(0.65 0.18 264);
  }
</style>
