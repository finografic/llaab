---
export const prerender = false;

import { listNodes } from '@llaab/core';
import type { SourceNode } from '@llaab/schemas';
import AppLayout from '../../../layouts/AppLayout.astro';

// ── Auth gate ─────────────────────────────────────────────────────────────────

const COOKIE_NAME = 'vault_key';
const password = import.meta.env.VAULT_PASSWORD ?? 'llaab';
const cookie = Astro.cookies.get(COOKIE_NAME);
if (cookie?.value !== password) return Astro.redirect('/vault/login', 302);

// ── Data ──────────────────────────────────────────────────────────────────────

const all = await listNodes({ type: 'source' });
const sources = all as SourceNode[];
sources.sort((a, b) => a.title.localeCompare(b.title));

const followed = sources.filter((s) => s.follow);
---

<AppLayout title="Sources">
  <div class="list-page">
    <header class="list-page__header">
      <p class="eyebrow">Vault</p>
      <h1 class="list-page__heading">Sources</h1>
      <p class="list-page__count">
        {sources.length} source{sources.length !== 1 ? 's' : ''}
        {followed.length > 0 && <span class="follow-count"> · {followed.length} followed</span>}
      </p>
    </header>

    {sources.length === 0 && (
      <p class="empty">No sources yet. Sources are created automatically when ingesting content.</p>
    )}

    <ul class="node-list" role="list">
      {sources.map((s) => (
        <li class="node-card">
          <a href={`/vault/sources/${s.id}`} class="node-card__link" aria-label={s.title}>
            <div class="node-card__meta">
              <span class={`badge badge--${s.source_kind}`}>{s.source_kind}</span>
              {s.follow && <span class="badge badge--follow">following</span>}
              <time class="node-card__date" datetime={s.created_at}>
                {new Date(s.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </div>

            <h2 class="node-card__title">{s.title}</h2>

            {s.body && <p class="node-card__body">{s.body}</p>}

            {s.platforms.length > 0 && (
              <div class="platform-row">
                {s.platforms.map((p) => (
                  <span class="platform">{p}</span>
                ))}
              </div>
            )}

            {s.tags.length > 0 && (
              <div class="tag-row">
                {s.tags.map((tag) => (
                  <span class="tag" data-tag={tag}>{tag}</span>
                ))}
              </div>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</AppLayout>

<style>
  .list-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 760px;
  }

  .list-page__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .list-page__heading {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .list-page__count {
    font-size: 12px;
    color: var(--text-faint);
  }

  .follow-count { color: #2563eb; }

  .empty {
    font-size: 13px;
    color: var(--text-muted);
  }

  /* ── Node list ── */

  .node-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .node-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color var(--duration) var(--ease);
  }

  .node-card:hover { border-color: var(--accent); }

  .node-card__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    text-decoration: none;
    color: inherit;
  }

  .node-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .node-card__title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.4;
  }

  .node-card__body {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .node-card__date {
    font-size: 11px;
    color: var(--text-faint);
    font-family: var(--font-mono);
    margin-left: auto;
  }

  /* ── Platform chips ── */

  .platform-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .platform {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--text-faint);
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: 1px 6px;
  }

  /* ── Tags ── */

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: 2px 7px;
    border-radius: 99px;
    font-size: 10px;
    font-family: var(--font-mono);
    font-weight: 500;
    background: color-mix(in srgb, var(--tag-color, var(--accent)) 12%, transparent);
    color: var(--tag-color, var(--accent));
    border: 1px solid color-mix(in srgb, var(--tag-color, var(--accent)) 30%, transparent);
  }

  .tag[data-tag='d:llm']         { --tag-color: #3b82f6; }
  .tag[data-tag='d:automation']  { --tag-color: #8b5cf6; }
  .tag[data-tag='d:ingest']      { --tag-color: #f59e0b; }
  .tag[data-tag='d:schema']      { --tag-color: #14b8a6; }
  .tag[data-tag='d:infra']       { --tag-color: #6b7280; }
  .tag[data-tag='d:integration'] { --tag-color: #f97316; }
  .tag[data-tag='d:ui']          { --tag-color: #ec4899; }
  .tag[data-tag='d:meta']        { --tag-color: #22c55e; }

  /* ── Badges ── */

  .badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 7px;
    border-radius: 99px;
    font-size: 10px;
    font-weight: 500;
    font-family: var(--font-mono);
    letter-spacing: 0.03em;
    background: var(--surface-raised);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
  }

  .badge--person       { background: #eff6ff; color: #2563eb; border-color: #bfdbfe; }
  .badge--channel      { background: #fef2f2; color: #dc2626; border-color: #fecaca; }
  .badge--repo         { background: #f5f3ff; color: #7c3aed; border-color: #ddd6fe; }
  .badge--publication  { background: #f0fdf4; color: #16a34a; border-color: #bbf7d0; }
  .badge--organization { background: #fff7ed; color: #ea580c; border-color: #fed7aa; }
  .badge--other        { background: var(--surface-raised); color: var(--text-muted); border-color: var(--border-subtle); }

  .badge--follow {
    background: #eff6ff;
    color: #2563eb;
    border-color: #bfdbfe;
    border-radius: 4px;
  }
</style>
