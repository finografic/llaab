---
export const prerender = false;

import { listNodes } from '@llaab/core';
import type { SourceNode, TranscriptNode } from '@llaab/schemas';
import AppLayout from '../../../layouts/AppLayout.astro';

// ── Auth gate ─────────────────────────────────────────────────────────────────

const COOKIE_NAME = 'vault_key';
const password = import.meta.env.VAULT_PASSWORD ?? 'llaab';
const cookie = Astro.cookies.get(COOKIE_NAME);
if (cookie?.value !== password) return Astro.redirect('/vault/login', 302);

// ── Data ──────────────────────────────────────────────────────────────────────

const { id } = Astro.params;
const all = await listNodes({ type: 'source' });
const source = (all as SourceNode[]).find((s) => s.id === id);

if (!source) return Astro.redirect('/vault/sources', 302);

// Load transcripts that reference this source
const transcriptNodes = await listNodes({ type: 'transcript' });
const linkedTranscripts = (transcriptNodes as TranscriptNode[]).filter((t) => t.source_id === source.id);
linkedTranscripts.sort((a, b) => b.created_at.localeCompare(a.created_at));

function fmtDate(ts?: string): string {
  if (!ts) return '—';
  return new Date(ts).toLocaleString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}
---

<AppLayout title={source.title}>
  <div class="detail-page">
    {/* ── Header ── */}
    <header class="detail-header">
      <nav class="mb-2 flex items-center gap-2 text-xs text-muted-foreground">
        <a href="/vault/sources" class="text-accent hover:underline">Sources</a>
        <span>›</span>
        <span>{source.title}</span>
      </nav>

      <h1 class="detail-header__title">{source.title}</h1>

      <div class="detail-header__meta">
        <span class={`badge badge--${source.source_kind}`}>{source.source_kind}</span>
        {source.follow && <span class="badge badge--follow">following</span>}
        <span class="meta-sep">·</span>
        <span class="meta-text">{fmtDate(source.created_at)}</span>
      </div>
    </header>

    {/* ── Tags ── */}
    {
      source.tags.length > 0 && (
        <div class="tag-row">
          {source.tags.map((tag) => (
            <span class="tag" data-tag={tag}>
              {tag}
            </span>
          ))}
        </div>
      )
    }

    {/* ── Body ── */}
    {
      source.body && (
        <section class="section">
          <h2 class="section__heading">About</h2>
          <p class="body-text">{source.body}</p>
        </section>
      )
    }

    {/* ── Details ── */}
    <section class="section">
      <h2 class="section__heading">Details</h2>
      <dl class="meta-grid">
        <dt>Kind</dt>
        <dd><span class={`badge badge--${source.source_kind}`}>{source.source_kind}</span></dd>

        <dt>Follow</dt>
        <dd>
          {
            source.follow ? (
              <span class="badge badge--follow">yes — auto-refresh enabled</span>
            ) : (
              <span class="meta-text">no</span>
            )
          }
        </dd>

        {
          source.url && (
            <>
              <dt>URL</dt>
              <dd>
                <a href={source.url} class="meta-link meta-mono" target="_blank" rel="noopener noreferrer">
                  {source.url}
                </a>
              </dd>
            </>
          )
        }

        {
          source.platforms.length > 0 && (
            <>
              <dt>Platforms</dt>
              <dd>
                <div class="platform-row">
                  {source.platforms.map((p) => (
                    <span class="platform">{p}</span>
                  ))}
                </div>
              </dd>
            </>
          )
        }
      </dl>
    </section>

    {/* ── Linked transcripts ── */}
    {
      linkedTranscripts.length > 0 && (
        <section class="section">
          <h2 class="section__heading">
            Transcripts
            <span class="section__count">{linkedTranscripts.length}</span>
          </h2>
          <ul class="transcript-list">
            {linkedTranscripts.map((t) => (
              <li class="transcript-item">
                <a href={`/vault/transcripts/${t.id}`} class="transcript-link">
                  <span class="transcript-title">{t.title}</span>
                  <span class="transcript-meta">
                    <span class={`badge badge--${t.source_type}`}>{t.source_type}</span>
                    {t.extracted_idea_ids.length > 0 && (
                      <span class="transcript-ideas">
                        {t.extracted_idea_ids.length} idea{t.extracted_idea_ids.length !== 1 ? 's' : ''}
                      </span>
                    )}
                    <time class="transcript-date" datetime={t.created_at}>
                      {new Date(t.created_at).toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                        year: 'numeric',
                      })}
                    </time>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</AppLayout>

<style>
  .detail-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 760px;
  }

  /* ── Header ── */

  .detail-header__title {
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
    line-height: 1.3;
  }

  .detail-header__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  .meta-sep {
    color: var(--text-faint);
  }
  .meta-text {
    font-size: var(--text-md);
    color: var(--text-faint);
  }
  .meta-mono {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    color: var(--text-muted);
  }

  .meta-link {
    color: var(--accent);
    text-decoration: none;
    font-size: var(--text-md);
  }
  .meta-link:hover {
    text-decoration: underline;
  }

  /* ── Sections ── */

  .section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .section__heading {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section__count {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: 99px;
    padding: 1px 6px;
    color: var(--text-faint);
    text-transform: none;
    letter-spacing: 0;
    font-weight: 500;
  }

  /* ── Meta grid ── */

  .meta-grid {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-base);
  }

  .meta-grid dt {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-top: 2px;
    white-space: nowrap;
  }

  .meta-grid dd {
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* ── Body ── */

  .body-text {
    font-size: var(--text-base);
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* ── Platform chips ── */

  .platform-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .platform {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--text-faint);
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: 1px 6px;
  }

  /* ── Transcript list ── */

  .transcript-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .transcript-item {
    border-radius: var(--radius);
    transition: background var(--duration) var(--ease);
  }

  .transcript-item:hover {
    background: var(--surface-raised);
  }

  .transcript-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-3);
    text-decoration: none;
    color: inherit;
  }

  .transcript-title {
    font-size: var(--text-base);
    color: var(--text);
    line-height: 1.4;
    flex: 1;
  }

  .transcript-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .transcript-ideas {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: oklch(0.65 0.18 264);
  }

  .transcript-date {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--text-faint);
    white-space: nowrap;
  }

  /* ── Source kind badges (base in app.css) ── */

  .badge--person {
    background: oklch(0.22 0.04 264 / 0.25);
    color: oklch(0.65 0.18 264);
    border-color: oklch(0.4 0.12 264 / 0.4);
  }
  .badge--channel {
    background: oklch(0.22 0.04 25 / 0.25);
    color: oklch(0.68 0.2 25);
    border-color: oklch(0.42 0.12 25 / 0.4);
  }
  .badge--repo {
    background: oklch(0.22 0.04 295 / 0.25);
    color: oklch(0.65 0.18 295);
    border-color: oklch(0.4 0.12 295 / 0.4);
  }
  .badge--publication {
    background: oklch(0.22 0.04 155 / 0.25);
    color: oklch(0.6 0.17 155);
    border-color: oklch(0.4 0.12 155 / 0.4);
  }
  .badge--organization {
    background: oklch(0.24 0.05 40 / 0.25);
    color: oklch(0.7 0.19 40);
    border-color: oklch(0.42 0.12 40 / 0.4);
  }
  .badge--youtube {
    background: oklch(0.22 0.04 25 / 0.25);
    color: oklch(0.68 0.2 25);
    border-color: oklch(0.42 0.12 25 / 0.4);
  }
  .badge--article {
    background: oklch(0.22 0.04 155 / 0.25);
    color: oklch(0.6 0.17 155);
    border-color: oklch(0.4 0.12 155 / 0.4);
  }
  .badge--chat {
    background: oklch(0.24 0.05 40 / 0.25);
    color: oklch(0.7 0.19 40);
    border-color: oklch(0.42 0.12 40 / 0.4);
  }
  .badge--follow {
    background: oklch(0.22 0.04 264 / 0.25);
    color: oklch(0.65 0.18 264);
    border-color: oklch(0.4 0.12 264 / 0.4);
    border-radius: 4px;
  }
</style>
