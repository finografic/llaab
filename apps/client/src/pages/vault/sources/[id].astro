---
export const prerender = false;

import { listNodes } from '@llaab/core';
import { enrichSourceMetadata, formatAudienceCount, hasYouTubeOAuthConfig } from '@llaab/ingestion';
import type { SourceNode, TranscriptNode } from '@llaab/schemas';
import { buttonVariants } from 'components/ui/button';
import { youTubeSubscribeUrl } from 'utils/youtube-source.utils';
import { SourceTranscriptsTable } from 'tables/SourceTranscriptsTable/SourceTranscriptsTable';
import type { SourceTranscriptsTableRow } from 'tables/SourceTranscriptsTable/SourceTranscriptsTable';
import SourceProfilesDialog from 'dialogs/SourceProfilesDialog/SourceProfilesDialog.astro';
import AppLayout from 'layouts/AppLayout.astro';
import PageLayout from 'layouts/PageLayout.astro';
import PageDetail from 'layouts/PageDetail.astro';
import PageHero from 'components/PageHero/PageHero.astro';

// ── Auth gate ─────────────────────────────────────────────────────────────────

const COOKIE_NAME = 'vault_key';
const password = import.meta.env.VAULT_PASSWORD ?? 'llaab';
const cookie = Astro.cookies.get(COOKIE_NAME);
if (cookie?.value !== password) return Astro.redirect('/vault/login', 302);

// ── Data ──────────────────────────────────────────────────────────────────────

const { id } = Astro.params;
const all = await listNodes({ type: 'source' });
let source = (all as SourceNode[]).find((s) => s.id === id);

if (!source) return Astro.redirect('/vault/sources', 302);

let enrichError: string | undefined;
let subscriptionError: string | undefined;
if (source.platforms.includes('youtube') && source.url) {
  try {
    const enriched = await enrichSourceMetadata(source);
    source = enriched.source;
    subscriptionError = enriched.subscriptionError;
  } catch (error) {
    enrichError = error instanceof Error ? error.message : 'Failed to refresh channel metadata.';
  }
}

// Load transcripts that reference this source
const transcriptNodes = await listNodes({ type: 'transcript' });
const linkedTranscripts = (transcriptNodes as TranscriptNode[]).filter((t) => t.source_id === source.id);
linkedTranscripts.sort((a, b) => b.created_at.localeCompare(a.created_at));
const linkedTranscriptRows: SourceTranscriptsTableRow[] = linkedTranscripts.map((transcript) => ({
  id: transcript.id,
  title: transcript.title,
  sourceType: transcript.source_type,
  sourceUrl: transcript.source_url,
  publishedAt: parseYouTubePublishedAt(transcript.body),
  transcriptCreatedAt: transcript.created_at,
  ideaCount: transcript.extracted_idea_ids.length,
}));

const isYouTubeChannel = source.platforms.includes('youtube') && source.source_kind === 'channel';
const youTubeSubscribeHref = isYouTubeChannel ? youTubeSubscribeUrl(source) : undefined;
const primaryProfilePlatform = isYouTubeChannel ? 'youtube' : undefined;
const suggestedGithubUrl = source.handle
  ? `https://github.com/${source.handle.replace(/^@/, '')}`
  : undefined;
const subscriberLabel =
  source.subscriber_count != null ? `${formatAudienceCount(source.subscriber_count)} subscribers` : undefined;
const videoLabel =
  source.video_count != null
    ? `${source.video_count.toLocaleString('en-US')} video${source.video_count === 1 ? '' : 's'}`
    : undefined;
const youtubeSubscriptionLabel =
  source.youtube_subscribed === true
    ? 'Subscribed on YouTube'
    : source.youtube_subscribed === false
      ? 'Not subscribed on YouTube'
      : undefined;

function fmtDate(ts?: string): string {
  if (!ts) return '—';
  return new Date(ts).toLocaleString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}

function parseYouTubePublishedAt(body: string): string | undefined {
  const match = body.match(/^\*\*uploaded:\*\*\s*(.+)$/m);
  if (!match?.[1]) return undefined;

  const parsed = new Date(`${match[1].trim().replace(' ', 'T')}Z`);
  return Number.isNaN(parsed.getTime()) ? undefined : parsed.toISOString();
}
---

<AppLayout title={source.title}>
  <PageLayout>
    <PageHero slot="hero" eyebrow="Vault" title={source.title}>
      <Fragment slot="meta">
        <span class={`badge badge--${source.source_kind}`}>{source.source_kind}</span>
        {
          isYouTubeChannel && youtubeSubscriptionLabel && (
            <span
              class={`badge ${
                source.youtube_subscribed === true ? 'badge--subscribed' : 'badge--not-subscribed'
              }`}
            >
              {youtubeSubscriptionLabel}
            </span>
          )
        }
        <span class="meta-sep">·</span>
        <span class="meta-text">{fmtDate(source.created_at)}</span>
      </Fragment>
    </PageHero>

    <PageDetail>
      {
        enrichError && (
          <p class="enrich-error" role="status">
            Could not refresh channel metadata: {enrichError}
          </p>
        )
      }

      {
        isYouTubeChannel && (source.avatar_url || subscriberLabel || videoLabel || source.handle) && (
          <section class="section channel-profile">
            <div class="channel-profile__header">
              {source.avatar_url && (
                <img
                  class="channel-profile__avatar"
                  src={source.avatar_url}
                  alt=""
                  width="80"
                  height="80"
                  loading="lazy"
                />
              )}
              <div class="channel-profile__identity">
                <div class="channel-profile__title-row">
                  <h2 class="channel-profile__title">{source.title}</h2>
                  {source.verified && (
                    <span class="channel-profile__verified" title="Verified channel">
                      ✓
                    </span>
                  )}
                </div>
                {(source.handle || subscriberLabel || videoLabel) && (
                  <p class="channel-profile__stats">
                    {source.handle && <span class="channel-profile__handle">{source.handle}</span>}
                    {source.handle && (subscriberLabel || videoLabel) && <span class="meta-sep">·</span>}
                    {subscriberLabel && <span>{subscriberLabel}</span>}
                    {subscriberLabel && videoLabel && <span class="meta-sep">·</span>}
                    {videoLabel && <span>{videoLabel}</span>}
                  </p>
                )}
                <div class="channel-profile__actions">
                  {source.url && (
                    <a
                      href={source.url}
                      class="meta-link channel-profile__link"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Open on YouTube
                    </a>
                  )}
                  {source.youtube_subscribed === false && youTubeSubscribeHref && (
                    <a
                      href={youTubeSubscribeHref}
                      class={buttonVariants({ variant: 'outline', size: 'sm' })}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Subscribe on YouTube
                    </a>
                  )}
                </div>
              </div>
            </div>
          </section>
        )
      }

      {/* ── Tags ── */}
      {
        source.tags.length > 0 && (
          <div class="tag-row">
            {source.tags.map((tag) => (
              <span class="tag" data-tag={tag}>
                {tag}
              </span>
            ))}
          </div>
        )
      }

      {/* ── Body ── */}
      {
        source.body && (
          <section class="section">
            <h2 class="section__heading">About</h2>
            <p class="body-text channel-profile__description">{source.body}</p>
          </section>
        )
      }

      {/* ── Details ── */}
      <section class="section">
        <h2 class="section__heading">Details</h2>
        <dl class="meta-grid">
          <dt>Kind</dt>
          <dd><span class={`badge badge--${source.source_kind}`}>{source.source_kind}</span></dd>

          {
            isYouTubeChannel && (
              <>
                <dt>YouTube Subscription</dt>
                <dd class="following-row">
                  {source.youtube_subscribed === true ? (
                    <span class="badge badge--subscribed">Subscribed</span>
                  ) : source.youtube_subscribed === false ? (
                    <>
                      <span class="badge badge--not-subscribed">Not subscribed</span>
                      {youTubeSubscribeHref && (
                        <a
                          href={youTubeSubscribeHref}
                          class={buttonVariants({ variant: 'outline', size: 'sm' })}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Subscribe on YouTube
                        </a>
                      )}
                    </>
                  ) : subscriptionError?.includes('invalid_grant') ? (
                    <span class="meta-text">unknown — {subscriptionError}</span>
                  ) : subscriptionError ? (
                    <span class="meta-text">unknown — {subscriptionError}</span>
                  ) : hasYouTubeOAuthConfig() ? (
                    <span class="meta-text">unknown — subscription check did not return a result</span>
                  ) : (
                    <span class="meta-text">
                      unknown — Google OAuth env vars not loaded; restart dev server
                    </span>
                  )}
                </dd>
              </>
            )
          }

          <dt>LLAAB Follow</dt>
          <dd>
            {
              source.follow ? (
                <span class="badge badge--follow">Auto-refresh enabled</span>
              ) : (
                <span class="meta-text">Auto-refresh off</span>
              )
            }
          </dd>

          {
            source.platform_id && (
              <>
                <dt>Channel ID</dt>
                <dd class="meta-mono">{source.platform_id}</dd>
              </>
            )
          }

          {
            source.url && (
              <>
                <dt>URL</dt>
                <dd>
                  <a href={source.url} class="meta-link meta-mono" target="_blank" rel="noopener noreferrer">
                    {source.url}
                  </a>
                </dd>
              </>
            )
          }

          {
            source.metadata_fetched_at && (
              <>
                <dt>Metadata</dt>
                <dd class="meta-text">refreshed {fmtDate(source.metadata_fetched_at)}</dd>
              </>
            )
          }

          {
            source.platforms.length > 0 && (
              <>
                <dt>Platforms</dt>
                <dd>
                  <SourceProfilesDialog
                    sourceId={source.id}
                    sourceTitle={source.title}
                    profiles={source.profiles}
                    primaryUrl={source.url}
                    primaryPlatform={primaryProfilePlatform}
                    suggestedGithubUrl={suggestedGithubUrl}
                  />
                </dd>
              </>
            )
          }
        </dl>
      </section>

      {/* ── Linked transcripts ── */}
      {
        linkedTranscripts.length > 0 && (
          <section class="section">
            <h2 class="section__heading">
              Transcripts
              <span class="section__count">{linkedTranscripts.length}</span>
            </h2>
            <SourceTranscriptsTable client:load transcripts={linkedTranscriptRows} />
          </section>
        )
      }
    </PageDetail>
  </PageLayout>
</AppLayout>

<style>
  .enrich-error {
    margin: 0 0 var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius);
    border: 1px solid oklch(0.42 0.12 40 / 0.4);
    background: oklch(0.24 0.05 40 / 0.25);
    color: oklch(0.7 0.19 40);
    font-size: var(--text-sm);
  }

  .channel-profile__header {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
  }

  .channel-profile__avatar {
    width: 80px;
    height: 80px;
    border-radius: 999px;
    object-fit: cover;
    border: 1px solid var(--border-subtle);
    flex-shrink: 0;
  }

  .channel-profile__identity {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .channel-profile__title-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .channel-profile__title {
    margin: 0;
    font-size: var(--text-xl);
    line-height: 1.2;
    color: var(--text);
  }

  .channel-profile__verified {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 999px;
    background: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    color: var(--text);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .channel-profile__stats {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-faint);
  }

  .channel-profile__handle {
    font-family: var(--font-mono);
    color: var(--text);
  }

  .channel-profile__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .channel-profile__link {
    font-size: var(--text-sm);
    width: fit-content;
  }

  .following-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .channel-profile__description {
    white-space: pre-wrap;
  }

  /* ── Source kind badges (base in app.css) ── */

  .badge--person {
    background: oklch(0.22 0.04 264 / 0.25);
    color: oklch(0.65 0.18 264);
    border-color: oklch(0.4 0.12 264 / 0.4);
  }
  .badge--channel {
    background: oklch(0.22 0.04 25 / 0.25);
    color: oklch(0.68 0.2 25);
    border-color: oklch(0.42 0.12 25 / 0.4);
  }
  .badge--repo {
    background: oklch(0.22 0.04 295 / 0.25);
    color: oklch(0.65 0.18 295);
    border-color: oklch(0.4 0.12 295 / 0.4);
  }
  .badge--publication {
    background: oklch(0.22 0.04 155 / 0.25);
    color: oklch(0.6 0.17 155);
    border-color: oklch(0.4 0.12 155 / 0.4);
  }
  .badge--organization {
    background: oklch(0.24 0.05 40 / 0.25);
    color: oklch(0.7 0.19 40);
    border-color: oklch(0.42 0.12 40 / 0.4);
  }
  .badge--youtube {
    background: oklch(0.22 0.04 25 / 0.25);
    color: oklch(0.68 0.2 25);
    border-color: oklch(0.42 0.12 25 / 0.4);
  }
  .badge--article {
    background: oklch(0.22 0.04 155 / 0.25);
    color: oklch(0.6 0.17 155);
    border-color: oklch(0.4 0.12 155 / 0.4);
  }
  .badge--chat {
    background: oklch(0.24 0.05 40 / 0.25);
    color: oklch(0.7 0.19 40);
    border-color: oklch(0.42 0.12 40 / 0.4);
  }
  .badge--subscribed {
    background: oklch(0.22 0.04 155 / 0.25);
    color: oklch(0.6 0.17 155);
    border-color: oklch(0.4 0.12 155 / 0.4);
    border-radius: 4px;
  }
  .badge--not-subscribed {
    background: oklch(0.24 0.04 40 / 0.2);
    color: oklch(0.7 0.12 40);
    border-color: oklch(0.42 0.1 40 / 0.35);
    border-radius: 4px;
  }
  .badge--follow {
    background: oklch(0.22 0.04 264 / 0.25);
    color: oklch(0.65 0.18 264);
    border-color: oklch(0.4 0.12 264 / 0.4);
    border-radius: 4px;
  }
</style>
