---
export const prerender = false;

import { listNodes } from '@llaab/core';
import type { RunNode } from '@llaab/schemas';
import { RunsTable } from '../../../components/RunsTable';
import AppLayout from '../../../layouts/AppLayout.astro';

// ── Auth gate ─────────────────────────────────────────────────────────────────

const COOKIE_NAME = 'vault_key';
const password = import.meta.env.VAULT_PASSWORD ?? 'llaab';
const cookie = Astro.cookies.get(COOKIE_NAME);
if (cookie?.value !== password) return Astro.redirect('/vault/login', 302);

// ── Data ──────────────────────────────────────────────────────────────────────

const all = await listNodes({ type: 'run' });
const runs = (all as RunNode[]).sort((a, b) => b.created_at.localeCompare(a.created_at));
---

<AppLayout title="Runs">
  <div class="list-page">
    <header class="list-page__header">
      <p class="eyebrow">Vault</p>
      <h1 class="list-page__heading">Runs</h1>
      <p class="list-page__count">{runs.length} run{runs.length !== 1 ? 's' : ''}</p>
    </header>

    <RunsTable runs={runs} client:load />
  </div>
</AppLayout>

<style>
  .list-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 900px;
  }

  .list-page__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .list-page__heading {
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .list-page__count {
    font-size: var(--text-md);
    color: var(--text-faint);
  }
</style>
