---
export const prerender = false;

import { listNodes } from '@llaab/core';
import type { RunNode, SourceNode } from '@llaab/schemas';
import { RunsTable } from 'tables/RunsTable';
import AppLayout from 'layouts/AppLayout.astro';
import PageLayout from 'layouts/PageLayout.astro';
import PageList from 'layouts/PageList.astro';
import PageHero from 'components/PageHero/PageHero.astro';

// ── Auth gate ─────────────────────────────────────────────────────────────────

const COOKIE_NAME = 'vault_key';
const password = import.meta.env.VAULT_PASSWORD ?? 'llaab';
const cookie = Astro.cookies.get(COOKIE_NAME);
if (cookie?.value !== password) return Astro.redirect('/vault/login', 302);

// ── Data ──────────────────────────────────────────────────────────────────────

const all = await listNodes({ type: 'run' });
const runs = (all as RunNode[]).toSorted((a, b) => b.created_at.localeCompare(a.created_at));
const sources = (await listNodes({ type: 'source' })) as SourceNode[];
---

<AppLayout title="Runs">
  <PageLayout>
    <PageHero slot="hero" eyebrow="Execute" title="Runs">
      <Fragment slot="meta">
        {runs.length} run{runs.length !== 1 ? 's' : ''}
      </Fragment>
    </PageHero>

    <PageList width="wide">
      <RunsTable runs={runs} sources={sources} client:load />
    </PageList>
  </PageLayout>
</AppLayout>
