---
export const prerender = false;

import { listNodes } from '@llaab/core';
import type { RunNode } from '@llaab/schemas';
import ModelMetaCard from 'components/ModelMetaCard.astro';
import AppLayout from 'layouts/AppLayout.astro';
import PageLayout from 'layouts/PageLayout.astro';
import PageHero from 'components/PageHero/PageHero.astro';

// ── Auth gate ─────────────────────────────────────────────────────────────────

const COOKIE_NAME = 'vault_key';
const password = import.meta.env.VAULT_PASSWORD ?? 'llaab';
const cookie = Astro.cookies.get(COOKIE_NAME);
if (cookie?.value !== password) return Astro.redirect('/vault/login', 302);

// ── Data ──────────────────────────────────────────────────────────────────────

const { id } = Astro.params;
const all = await listNodes({ type: 'run' });
const run = (all as RunNode[]).find((r) => r.id === id);

if (!run) return Astro.redirect('/vault/runs', 302);

function fmtDuration(ms?: number): string {
  if (ms == null) return '—';
  if (ms < 1000) return `${ms}ms`;
  return `${(ms / 1000).toFixed(1)}s`;
}

function fmtDate(ts?: string): string {
  if (!ts) return '—';
  return new Date(ts).toLocaleString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
}
---

<AppLayout title={run.title}>
  <PageLayout>
    <PageHero slot="hero" eyebrow="Execute" title={run.title}>
      <Fragment slot="meta">
        <span class={`badge badge--${run.run_status}`}>{run.run_status}</span>
        <span class="meta-sep">·</span>
        <span class="meta-text">{fmtDate(run.started_at ?? run.created_at)}</span>
        {
          run.duration_ms != null && (
            <>
              <span class="meta-sep">·</span>
              <span class="meta-text">{fmtDuration(run.duration_ms)}</span>
            </>
          )
        }
        {
          run.model_used && (
            <>
              <span class="meta-sep">·</span>
              <span class="meta-text meta-mono">{run.model_used}</span>
            </>
          )
        }
      </Fragment>
    </PageHero>

    <div class="detail-page">
      {/* ── Summary ── */}
      {
        run.llm && (
          <ModelMetaCard
            title="Run model"
            meta={{
              model: run.llm.model,
              provider: run.llm.provider,
              durationMs: run.llm.duration_ms,
              promptTokens: run.llm.prompt_tokens,
              completionTokens: run.llm.completion_tokens,
            }}
          />
        )
      }

      {
        (run.input_summary ?? run.output_summary) && (
          <section class="section">
            <h2 class="section__heading">Summary</h2>
            <dl class="summary-grid">
              {run.input_summary && (
                <>
                  <dt>Input</dt>
                  <dd>{run.input_summary}</dd>
                </>
              )}
              {run.output_summary && (
                <>
                  <dt>Output</dt>
                  <dd>{run.output_summary}</dd>
                </>
              )}
              {run.produced_node_ids.length > 0 && (
                <>
                  <dt>Produced</dt>
                  <dd>
                    <ul class="produced-list">
                      {run.produced_node_ids.map((nid) => (
                        <li class="produced-id">{nid}</li>
                      ))}
                    </ul>
                  </dd>
                </>
              )}
            </dl>
          </section>
        )
      }

      {/* ── Stages ── */}
      {
        run.stages.length > 0 && (
          <section class="section">
            <h2 class="section__heading">Stages</h2>
            <div class="overflow-x-auto rounded-md border border-border">
              <table class="w-full border-collapse text-xs">
                <thead>
                  <tr class="border-b border-border bg-[var(--bg-subtle)]">
                    <th class="w-10 px-4 py-2 text-center font-medium uppercase tracking-[0.04em] text-muted-foreground whitespace-nowrap">
                      #
                    </th>
                    <th class="px-4 py-2 text-left font-medium uppercase tracking-[0.04em] text-muted-foreground whitespace-nowrap">
                      Stage
                    </th>
                    <th class="px-4 py-2 text-left font-medium uppercase tracking-[0.04em] text-muted-foreground whitespace-nowrap">
                      Status
                    </th>
                    <th class="px-4 py-2 text-left font-medium uppercase tracking-[0.04em] text-muted-foreground whitespace-nowrap">
                      Notes
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {run.stages.map((stage, i) => (
                    <tr class="border-b border-border-subtle last:border-0">
                      <td class="w-10 px-4 py-3 text-center font-mono text-muted-foreground align-middle">
                        {i + 1}
                      </td>
                      <td class="px-4 py-3 font-medium text-foreground align-middle">{stage.name}</td>
                      <td class="px-4 py-3 align-middle">
                        <span class={`badge badge--stage-${stage.status}`}>{stage.status}</span>
                      </td>
                      <td class="px-4 py-3 text-[11px] align-middle">
                        {stage.error && <span class="stage-error">{stage.error}</span>}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )
      }

      {/* ── Decisions ── */}
      {
        run.decisions.length > 0 && (
          <section class="section">
            <h2 class="section__heading">Decisions</h2>
            <ul class="decision-list">
              {run.decisions.map((d) => (
                <li class="decision-item">
                  <span class={`badge badge--decision-${d.type}`}>{d.type}</span>
                  <span class="decision-reason">{d.reason}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {/* ── Error ── */}
      {
        run.error && (
          <section class="section">
            <h2 class="section__heading section__heading--error">Error</h2>
            <pre class="error-pre">{run.error}</pre>
          </section>
        )
      }

      {/* ── Body / notes ── */}
      {
        run.body && (
          <section class="section">
            <h2 class="section__heading">Notes</h2>
            <pre class="body-pre">{run.body}</pre>
          </section>
        )
      }
    </div>
  </PageLayout>
</AppLayout>

<style>
  .detail-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: 820px;
  }

  .meta-sep {
    color: var(--text-faint);
  }

  .meta-text {
    font-size: var(--text-md);
    color: var(--text-faint);
  }

  .meta-mono {
    font-family: var(--font-mono);
  }

  /* ── Sections ── */

  .section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .section__heading {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section__heading--error {
    color: oklch(0.68 0.2 25);
  }

  /* ── Summary grid ── */

  .summary-grid {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-base);
  }

  .summary-grid dt {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-top: 2px;
  }

  .summary-grid dd {
    color: var(--text-muted);
    line-height: 1.5;
  }

  .produced-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .produced-id {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-faint);
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: 1px 6px;
  }

  .stage-error {
    color: oklch(0.68 0.2 25);
    font-family: var(--font-mono);
  }

  /* ── Decisions ── */

  .decision-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .decision-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--text-base);
    color: var(--text-muted);
  }

  .decision-reason {
    line-height: 1.5;
  }

  /* ── Pre blocks ── */

  .error-pre,
  .body-pre {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    line-height: 1.7;
    white-space: pre-wrap;
    word-break: break-word;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-4);
    color: var(--text-muted);
  }

  .error-pre {
    color: oklch(0.68 0.2 25);
    border-color: oklch(0.42 0.12 25 / 0.4);
    background: oklch(0.22 0.04 25 / 0.25);
  }

  /* ── Run badge variants (base in app.css) ── */

  .badge--pending {
    background: var(--surface-raised);
    color: var(--text-faint);
    border-color: var(--border-subtle);
  }
  .badge--running {
    background: oklch(0.24 0.05 40 / 0.25);
    color: oklch(0.7 0.19 40);
    border-color: oklch(0.42 0.12 40 / 0.4);
  }
  .badge--completed {
    background: oklch(0.22 0.04 155 / 0.25);
    color: oklch(0.6 0.17 155);
    border-color: oklch(0.4 0.12 155 / 0.4);
  }
  .badge--failed {
    background: oklch(0.22 0.04 25 / 0.25);
    color: oklch(0.68 0.2 25);
    border-color: oklch(0.42 0.12 25 / 0.4);
  }
  .badge--cancelled {
    background: var(--surface-raised);
    color: var(--text-faint);
    border-color: var(--border-subtle);
    opacity: 0.6;
  }
  .badge--stage-pending {
    background: var(--surface-raised);
    color: var(--text-faint);
    border-color: var(--border-subtle);
  }
  .badge--stage-completed {
    background: oklch(0.22 0.04 155 / 0.25);
    color: oklch(0.6 0.17 155);
    border-color: oklch(0.4 0.12 155 / 0.4);
  }
  .badge--stage-failed {
    background: oklch(0.22 0.04 25 / 0.25);
    color: oklch(0.68 0.2 25);
    border-color: oklch(0.42 0.12 25 / 0.4);
  }
  .badge--decision-accept {
    background: oklch(0.22 0.04 155 / 0.25);
    color: oklch(0.6 0.17 155);
    border-color: oklch(0.4 0.12 155 / 0.4);
  }
  .badge--decision-retry {
    background: oklch(0.24 0.05 40 / 0.25);
    color: oklch(0.7 0.19 40);
    border-color: oklch(0.42 0.12 40 / 0.4);
  }
  .badge--decision-reject {
    background: oklch(0.22 0.04 25 / 0.25);
    color: oklch(0.68 0.2 25);
    border-color: oklch(0.42 0.12 25 / 0.4);
  }
  .badge--decision-downgrade {
    background: oklch(0.22 0.04 295 / 0.25);
    color: oklch(0.65 0.18 295);
    border-color: oklch(0.4 0.12 295 / 0.4);
  }
</style>
