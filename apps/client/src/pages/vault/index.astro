---
export const prerender = false;

import { readdir } from 'node:fs/promises';
import path from 'node:path';
import AppLayout from '../../layouts/AppLayout.astro';
import { VaultBrowser } from '../../components/VaultBrowser';
import type { VaultNode } from '../../components/VaultBrowser';
import { VAULT_ROOT } from '@llaab/core';

// ── Auth gate ─────────────────────────────────────────────────────────────────

const COOKIE_NAME = 'vault_key';
const password = import.meta.env.VAULT_PASSWORD ?? 'llaab';
const cookie = Astro.cookies.get(COOKIE_NAME);
if (cookie?.value !== password) return Astro.redirect('/vault/login', 302);

// ── Build vault file tree ─────────────────────────────────────────────────────

const SKIP = new Set(['.tmp', '.DS_Store', '.gitkeep']);

async function readTree(dir: string, rel = ''): Promise<VaultNode[]> {
  const entries = await readdir(dir, { withFileTypes: true });
  const nodes: VaultNode[] = [];
  for (const entry of entries) {
    if (SKIP.has(entry.name) || entry.name.startsWith('.')) continue;
    const entryRel = rel ? `${rel}/${entry.name}` : entry.name;
    if (entry.isDirectory()) {
      nodes.push({
        name: entry.name,
        path: entryRel,
        type: 'dir',
        children: await readTree(path.join(dir, entry.name), entryRel),
      });
    } else {
      nodes.push({ name: entry.name, path: entryRel, type: 'file' });
    }
  }
  return nodes.sort((a, b) => {
    if (a.type !== b.type) return a.type === 'dir' ? -1 : 1;
    return a.name.localeCompare(b.name);
  });
}

const tree = await readTree(VAULT_ROOT);
---

<AppLayout title="Vault">
  <VaultBrowser tree={tree} client:load />
</AppLayout>

<style>
  /* VaultBrowser fills the page-content area — remove padding + scrolling */
  :global(.page-content) {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* ── Browser shell ── */
  :global(.vault-browser) {
    display: flex;
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  /* ── Tree sidebar ── */
  :global(.vault-tree) {
    width: 320px;
    flex-shrink: 0;
    overflow-y: auto;
    border-right: 1px solid var(--border);
    padding: var(--space-2) 0;
    background: var(--bg-subtle);
  }

  :global(.tree-root),
  :global(.tree-children) {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  :global(.tree-children) {
    padding-left: 14px;
    border-left: 1px solid var(--border-subtle);
    margin-left: 12px;
  }

  :global(.tree-btn) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    padding: 4px 12px;
    background: none;
    border: none;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    text-align: left;
    cursor: pointer;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition:
      color var(--duration) var(--ease),
      background var(--duration) var(--ease);
  }

  :global(.tree-btn:hover) { color: var(--text); background: var(--surface); }
  :global(.tree-btn--dir) { color: var(--text); font-weight: 500; }
  :global(.tree-btn--file[data-selected]) {
    color: var(--accent);
    background: var(--accent-subtle);
  }

  :global(.tree-chevron) {
    font-size: 10px;
    color: var(--text-faint);
    flex-shrink: 0;
    width: 12px;
    text-align: center;
  }

  :global(.tree-label) {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Content viewer ── */
  :global(.vault-viewer) {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-6);
    min-width: 0;
  }

  :global(.vault-viewer__empty),
  :global(.vault-viewer__loading) {
    color: var(--text-faint);
    font-size: 13px;
  }

  :global(.vault-viewer__error) {
    color: var(--error-text);
    font-size: 13px;
  }

  :global(.vault-viewer__content) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  :global(.vault-viewer__path) {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: 0.04em;
  }

  :global(.vault-viewer__pre) {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.7;
    color: var(--text);
    white-space: pre-wrap;
    word-break: break-word;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-5);
  }
</style>
