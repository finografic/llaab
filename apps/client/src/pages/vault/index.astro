---
export const prerender = false;

import { readdir } from 'node:fs/promises';
import path from 'node:path';
import AppLayout from 'layouts/AppLayout.astro';
import PageLayout from 'layouts/PageLayout.astro';
import PageHero from 'components/PageHero/PageHero.astro';
import { VaultBrowser } from 'components/VaultBrowser';
import type { VaultNode } from '../../components/VaultBrowser';
import { VAULT_ROOT } from '@llaab/core';

// ── Auth gate ─────────────────────────────────────────────────────────────────

const COOKIE_NAME = 'vault_key';
const password = import.meta.env.VAULT_PASSWORD ?? 'llaab';
const cookie = Astro.cookies.get(COOKIE_NAME);
if (cookie?.value !== password) return Astro.redirect('/vault/login', 302);

// ── Build vault file tree ─────────────────────────────────────────────────────

const SKIP = new Set(['.tmp', '.DS_Store', '.gitkeep']);

async function readTree(dir: string, rel = ''): Promise<VaultNode[]> {
  const entries = await readdir(dir, { withFileTypes: true });
  const nodes: VaultNode[] = [];
  for (const entry of entries) {
    if (SKIP.has(entry.name) || entry.name.startsWith('.')) continue;
    const entryRel = rel ? `${rel}/${entry.name}` : entry.name;
    if (entry.isDirectory()) {
      nodes.push({
        name: entry.name,
        path: entryRel,
        type: 'dir',
        children: await readTree(path.join(dir, entry.name), entryRel),
      });
    } else {
      nodes.push({ name: entry.name, path: entryRel, type: 'file' });
    }
  }
  return nodes.sort((a, b) => {
    if (a.type !== b.type) return a.type === 'dir' ? -1 : 1;
    return a.name.localeCompare(b.name);
  });
}

const tree = await readTree(VAULT_ROOT);
---

<AppLayout title="Vault">
  <PageLayout>
    <PageHero slot="hero" eyebrow="Vault" title="Browse Vault" />
    <VaultBrowser tree={tree} client:load />
  </PageLayout>
</AppLayout>

<style>
  /* VaultBrowser fills the page-content area — remove padding + allow flex child to stretch */
  :global(.page-content) {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
</style>
