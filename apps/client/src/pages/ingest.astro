---
import AppLayout from '../layouts/AppLayout.astro';
import { IngestForm } from '../components/IngestForm';
---

<AppLayout title="Ingest">
  <div class="ingest-page">
    <header class="ingest-page__header">
      <p class="eyebrow">Ingest</p>
      <h1 class="ingest-page__heading">Ingest YouTube Transcript</h1>
      <p class="ingest-page__desc">
        Paste a YouTube URL to fetch, clean, and store its transcript in the vault.
      </p>
    </header>

    <div class="card ingest-page__card">
      <IngestForm client:only="react" />
    </div>
  </div>
</AppLayout>

<style>
  .ingest-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: 560px;
  }

  .ingest-page__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .ingest-page__heading {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .ingest-page__desc {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* IngestForm root — flex column for the form + status blocks */
  :global(.ingest-form) {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* URL input uses monospace — intentional for this form */
  :global(.ingest-form .field input) {
    font-family: var(--font-mono);
    font-size: 13px;
  }

  /* Tag suggestion dropdown */
  :global(.tag-suggestions) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: calc(var(--space-1) * -1);
  }

  :global(.tag-suggestion) {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: 99px;
    font-size: 11px;
    font-family: var(--font-mono);
    font-weight: 500;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-muted);
    cursor: pointer;
    transition:
      color var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      background var(--duration) var(--ease);
  }

  :global(.tag-suggestion:hover) {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  :global(.status-card__link) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    opacity: 0.85;
  }

  :global(.status-card__link:hover) {
    opacity: 1;
  }

  :global(.status-card__idea-list) {
    margin: 0;
    padding-left: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: 13px;
    font-family: var(--font-mono);
  }

  :global(.status-card__retry-btn) {
    align-self: flex-start;
    margin-top: var(--space-1);
    padding: 4px 10px;
    border-radius: var(--radius);
    font-size: 12px;
    font-weight: 500;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    color: var(--text);
    cursor: pointer;
    transition: opacity var(--duration) var(--ease);
  }

  :global(.status-card__retry-btn:hover:not(:disabled)) {
    opacity: 0.8;
  }

  :global(.status-card__retry-btn:disabled) {
    opacity: 0.4;
    cursor: not-allowed;
  }

  :global(.status-card__retry-btn--warning) {
    background: var(--warning-bg);
    border-color: var(--warning-border);
    color: var(--warning-text);
  }
</style>
