---
export const prerender = false;

import { listNodes } from '@llaab/core';
import type { RunNode, SourceNode } from '@llaab/schemas';
import AppLayout from 'layouts/AppLayout.astro';
import PageLayout from 'layouts/PageLayout.astro';
import PageHero from 'components/PageHero/PageHero.astro';
import { CleanVaultDialog } from 'dialogs/CleanVaultDialog/CleanVaultDialog';
import { IngestForm } from 'forms/IngestForm/IngestForm';
import { RunsTable } from 'tables/RunsTable/RunsTable';

const all = await listNodes({ type: 'run' });
const runs = (all as RunNode[]).toSorted((a, b) => b.created_at.localeCompare(a.created_at));
const sources = (await listNodes({ type: 'source' })) as SourceNode[];
---

<AppLayout title="Ingest">
  <PageLayout>
    <PageHero slot="hero" eyebrow="Pipeline" title="Ingest Source URL">
      <CleanVaultDialog slot="right" client:only="react" resetIngestFormOnSuccess />
      <Fragment slot="description">
        Paste or drop a browser URL. The form will classify the source asset and adapt the ingest action when
        the URL is supported.
      </Fragment>
    </PageHero>

    <div class="ingest-page">
      <div class="card ingest-page__card">
        <IngestForm client:only="react" />
      </div>

      <RunsTable client:load runs={runs} sources={sources} showHeading />
    </div>
  </PageLayout>
</AppLayout>

<style>
  .ingest-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: var(--content-max);
  }

  .ingest-page__card {
    min-height: 352px;
  }

  /* IngestForm root — flex column for the form + status blocks */
  :global(.ingest-form) {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px dashed var(--border);
    border-radius: calc(var(--radius) * 1.25);
    background:
      linear-gradient(180deg, color-mix(in oklab, var(--surface) 85%, transparent), transparent),
      var(--surface);
    transition:
      border-color var(--duration) var(--ease),
      background var(--duration) var(--ease),
      transform var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease);
  }

  :global(.ingest-form__stack) {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  :global(.ingest-form--drop-active) {
    border-color: oklch(0.68 0.2 145);
    border-style: dotted;
    background: color-mix(in oklab, oklch(0.68 0.2 145 / 0.1) 100%, var(--surface));
    transform: translateY(-1px);
    box-shadow: 0 0 0 1px oklch(0.68 0.2 145 / 0.25);
  }

  /* URL input uses monospace — intentional for this form */
  :global(.ingest-form .field input) {
    font-family: var(--font-mono);
    font-size: var(--text-base);
  }

  :global(.ingest-dropzone__eyebrow) {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  :global(.ingest-dropzone__title) {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
  }

  :global(.ingest-dropzone__desc) {
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--text-muted);
  }

  :global(.field-hint) {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: var(--text-md);
    color: var(--text-muted);
  }

  :global(.field-hint--success) {
    color: var(--accent);
  }

  /* Tag suggestion dropdown */
  :global(.tag-suggestions) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: calc(var(--space-1) * -1);
  }

  :global(.tag-suggestion) {
    border-radius: 99px !important;
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    font-weight: 500;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-muted);
    cursor: pointer;
    transition:
      color var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      background var(--duration) var(--ease);
  }

  :global(.tag-suggestion:hover) {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-subtle);
  }

  :global(.status-card__link) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    opacity: 0.85;
  }

  :global(.status-card__link:hover) {
    opacity: 1;
  }

  :global(.status-card__idea-list) {
    margin: 0;
    padding-left: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-base);
    font-family: var(--font-mono);
  }

  :global(.status-card__retry-btn) {
    align-self: flex-start;
    margin-top: var(--space-1);
    padding: 4px 10px;
    border-radius: var(--radius);
    font-size: var(--text-md);
    font-weight: 500;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    color: var(--text);
    cursor: pointer;
    transition: opacity var(--duration) var(--ease);
  }

  :global(.status-card__retry-btn:hover:not(:disabled)) {
    opacity: 0.8;
  }

  :global(.status-card__retry-btn:disabled) {
    opacity: 0.4;
    cursor: not-allowed;
  }

  :global(.status-card__retry-btn--warning) {
    background: var(--warning-bg);
    border-color: var(--warning-border);
    color: var(--warning-text);
  }

  /* ── Pipeline cards ──────────────────────────────────────────────────────── */

  :global(.pipeline) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  :global(.pipeline-card) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface-raised);
    transition:
      border-color var(--duration) var(--ease),
      background var(--duration) var(--ease);
  }

  :global(.pipeline-card--success) {
    border-color: oklch(0.68 0.2 145 / 0.45);
    background: oklch(0.68 0.2 145 / 0.07);
  }

  :global(.pipeline-card--warning) {
    border-color: oklch(0.72 0.14 55 / 0.45);
    background: oklch(0.72 0.14 55 / 0.07);
  }

  :global(.pipeline-card__main) {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  :global(.pipeline-card__row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  :global(.pipeline-card__title) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  :global(.pipeline-card__meta) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  :global(.pipeline-card__label) {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  :global(.pipeline-card__node-count) {
    flex-shrink: 0;
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    font-weight: 500;
    opacity: 0.5;
    letter-spacing: 0.04em;
  }

  :global(.pipeline-card__meta-sep) {
    flex-shrink: 0;
    opacity: 0.3;
    font-size: var(--text-sm);
  }

  :global(.pipeline-card__elapsed) {
    flex-shrink: 0;
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    font-weight: 500;
    opacity: 0.5;
    letter-spacing: 0.04em;
  }

  :global(.pipeline-card--active) {
    border-color: color-mix(in oklab, var(--accent) 50%, transparent);
    background: color-mix(in oklab, var(--accent) 8%, var(--surface));
  }

  :global(.pipeline-card--neutral .pipeline-card__label) {
    color: var(--text-muted);
  }

  :global(.pipeline-card--active .pipeline-card__label) {
    color: var(--accent);
  }

  :global(.pipeline-card--success .pipeline-card__label) {
    color: oklch(0.68 0.2 145);
  }

  :global(.pipeline-card--warning .pipeline-card__label) {
    color: oklch(0.72 0.14 55);
  }

  :global(.pipeline-card__status) {
    flex-shrink: 0;
    width: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.pipeline-card__body) {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-top: var(--space-3);
    border-top: 1px solid color-mix(in oklab, currentColor 15%, transparent);
    margin-top: var(--space-1);
  }

  :global(.pipeline-card__failure) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  :global(.pipeline-card__text) {
    font-size: var(--text-md);
    color: var(--text-muted);
  }

  :global(.pipeline-card__path) {
    font-size: var(--text-md);
    font-family: var(--font-mono);
    word-break: break-all;
  }

  :global(.pipeline-card__link) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    opacity: 0.85;
  }

  :global(.pipeline-card__link:hover) {
    opacity: 1;
  }

  :global(.pipeline-card__item-list) {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-md);
    font-family: var(--font-mono);
  }

  :global(.pipeline-card__item-list li) {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  :global(.pipeline-card__item-list li::before) {
    content: '▪';
    flex-shrink: 0;
    font-size: var(--text-xs);
    opacity: 0.5;
  }

  /* ── Pipeline icons ──────────────────────────────────────────────────────── */

  :global(.pipeline-icon) {
    width: 14px;
    height: 14px;
  }

  :global(.pipeline-card--neutral .pipeline-icon) {
    color: var(--text-muted);
  }

  :global(.pipeline-card--active .pipeline-icon),
  :global(.pipeline-card--active svg) {
    color: var(--accent);
  }

  :global(.pipeline-card--success .pipeline-icon) {
    color: oklch(0.68 0.2 145);
  }

  :global(.pipeline-card--warning .pipeline-icon) {
    color: oklch(0.72 0.14 55);
  }

  :global(.pipeline-icon--waiting) {
    opacity: 0.35;
  }

  /* ── Pipeline retry button ───────────────────────────────────────────────── */

  :global(.pipeline-retry-btn) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: var(--radius);
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    cursor: pointer;
    opacity: 0.65;
    transition: opacity var(--duration) var(--ease);
  }

  :global(.pipeline-retry-btn:hover:not(:disabled)) {
    opacity: 1;
  }

  :global(.pipeline-retry-btn:disabled) {
    opacity: 0.25;
    cursor: not-allowed;
  }

  :global(.pipeline-retry-btn svg) {
    width: 11px;
    height: 11px;
  }

  /* ── Run summary card ────────────────────────────────────────────────────── */

  :global(.pipeline-card--summary) {
    flex-direction: column;
    align-items: stretch;
  }

  /* Running → blue/cyan instead of accent green */
  :global(.pipeline-card--summary.pipeline-card--active) {
    border-color: oklch(0.65 0.18 220 / 0.45);
    background: oklch(0.65 0.18 220 / 0.07);
  }

  :global(.pipeline-card--summary.pipeline-card--active .pipeline-card__label) {
    color: oklch(0.72 0.16 220);
  }

  :global(.pipeline-card--summary.pipeline-card--active .pipeline-card__elapsed) {
    color: oklch(0.72 0.16 220);
  }

  :global(.pipeline-card--summary.pipeline-card--active svg) {
    color: oklch(0.72 0.16 220);
  }

  /* Complete → neutral/default instead of success green */
  :global(.pipeline-card--summary.pipeline-card--success) {
    border-color: var(--border);
    background: var(--surface-raised);
  }

  :global(.pipeline-card--summary.pipeline-card--success .pipeline-card__label) {
    color: var(--text-muted);
  }

  :global(.pipeline-card--summary.pipeline-card--success .pipeline-icon) {
    color: var(--text-faint);
  }

  :global(.pipeline-summary__left) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
  }

  :global(.pipeline-summary__step) {
    font-size: var(--text-md);
    color: var(--text-muted);
    font-family: var(--font-mono);
    truncate: true;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.pipeline-summary__actions) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid color-mix(in oklab, currentColor 15%, transparent);
    margin-top: var(--space-1);
  }

  /* ── Action buttons ──────────────────────────────────────────────────────── */

  :global(.pipeline-action-btn) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 4px 10px;
    border-radius: var(--radius);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    border: 1px solid transparent;
    cursor: pointer;
    transition:
      opacity var(--duration) var(--ease),
      background var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  :global(.pipeline-action-btn:disabled) {
    opacity: 0.4;
    cursor: not-allowed;
  }

  :global(.pipeline-action-btn--keep) {
    background: oklch(0.68 0.2 145 / 0.15);
    border-color: oklch(0.68 0.2 145 / 0.4);
    color: oklch(0.68 0.2 145);
  }

  :global(.pipeline-action-btn--keep:hover:not(:disabled)) {
    background: oklch(0.68 0.2 145 / 0.25);
    border-color: oklch(0.68 0.2 145 / 0.7);
  }

  :global(.pipeline-action-btn--discard) {
    background: oklch(0.56 0.16 28 / 0.12);
    border-color: oklch(0.56 0.16 28 / 0.35);
    color: oklch(0.72 0.16 28);
  }

  :global(.pipeline-action-btn--discard:hover:not(:disabled)) {
    background: oklch(0.56 0.16 28 / 0.22);
    border-color: oklch(0.56 0.16 28 / 0.6);
  }

  :global(.pipeline-action-btn--retry) {
    background: var(--surface-raised);
    border-color: var(--border);
    color: var(--text-muted);
    margin-left: auto;
  }

  :global(.pipeline-action-btn--retry:hover:not(:disabled)) {
    color: var(--text);
    border-color: var(--text-faint);
  }
</style>
