---
export const prerender = false;

import AppLayout from 'layouts/AppLayout.astro';
import PageLayout from 'layouts/PageLayout.astro';
import PageHero from 'components/PageHero/PageHero.astro';
import { LlmRoutingEditor } from 'components/LlmRoutingEditor/LlmRoutingEditor';
import { LlmModelInfoList } from 'components/LlmModelInfoList/LlmModelInfoList';

// ── Fetch status from server ───────────────────────────────────────────────────

const SERVER_ORIGIN = import.meta.env.SERVER_URL ?? 'http://localhost:3000';
const API_KEY = import.meta.env.SERVER_API_KEY ?? '';

interface RoutingEntry {
  tier: 'local-small' | 'local-mid' | 'local-strong' | 'remote';
  model: string;
  provider: 'ollama' | 'anthropic';
}

interface LlmStatusResponse {
  routing: Record<
    'route' | 'format' | 'extract' | 'code' | 'reason' | 'reason-plus' | 'vision' | 'speech',
    RoutingEntry
  >;
  modelMap: Record<string, string>;
  installedModelDetails: Array<{
    digest?: string;
    details?: {
      families?: string[];
      family?: string;
      format?: string;
      parameter_size?: string;
      parent_model?: string;
      quantization_level?: string;
    };
    modified_at?: Date | string;
    name: string;
    size?: number;
  }>;
  installedModels: string[];
  ollamaError?: string;
}

let status: LlmStatusResponse | null = null;
let fetchError: string | null = null;

try {
  const headers: Record<string, string> = { 'Content-Type': 'application/json' };
  if (API_KEY) headers['X-API-Key'] = API_KEY;
  const res = await fetch(`${SERVER_ORIGIN}/api/llm/status`, { headers });
  status = (await res.json()) as LlmStatusResponse;
} catch (err) {
  fetchError = err instanceof Error ? err.message : 'Failed to reach server';
}
---

<AppLayout title="LLM Status">
  <PageLayout>
    <PageHero slot="hero" eyebrow="Models" title="Status">
      <Fragment slot="description">Active model routing and installed Ollama models.</Fragment>
    </PageHero>

    <div class="llm-page">
      {
        fetchError && (
          <div class="alert alert--error">
            <span class="alert__label">Server unreachable</span>
            <span class="alert__msg">{fetchError}</span>
          </div>
        )
      }

      {
        status && (
          <div class="llm-sections">
            {/* ── Task routing ── */}
            <section class="llm-section">
              <h2 class="llm-section__heading">Task routing</h2>
              <LlmRoutingEditor
                routing={status.routing}
                installedModels={status.installedModels}
                remoteModels={[status.modelMap.remote].filter(Boolean)}
                client:load
              />
            </section>

            {/* ── Installed models ── */}
            <section class="llm-section">
              <h2 class="llm-section__heading">
                Installed Ollama models
                {status.ollamaError && (
                  <span class="llm-section__badge llm-section__badge--err">offline</span>
                )}
                {!status.ollamaError && (
                  <span class="llm-section__badge llm-section__badge--ok">
                    {status.installedModels.length} models
                  </span>
                )}
              </h2>

              {status.ollamaError && <p class="llm-empty">{status.ollamaError}</p>}

              {!status.ollamaError && status.installedModels.length === 0 && (
                <p class="llm-empty">No models found — is Ollama running?</p>
              )}

              {status.installedModelDetails.length > 0 && (
                <LlmModelInfoList models={status.installedModelDetails} client:load />
              )}
            </section>

            {/* ── Installed models list ── */}
            <section class="llm-section">
              <h2 class="llm-section__heading">
                Installed Ollama models
                {status.ollamaError && (
                  <span class="llm-section__badge llm-section__badge--err">offline</span>
                )}
                {!status.ollamaError && (
                  <span class="llm-section__badge llm-section__badge--ok">
                    {status.installedModels.length} models
                  </span>
                )}
              </h2>

              {status.ollamaError && <p class="llm-empty">{status.ollamaError}</p>}

              {!status.ollamaError && status.installedModels.length === 0 && (
                <p class="llm-empty">No models found — is Ollama running?</p>
              )}

              {status.installedModelDetails.length > 0 && (
                <ul class="model-list">
                  {status.installedModelDetails.map((model) => (
                    <li class="model-item">
                      <span class="route-dot route-dot--ok" />
                      <span class="model-name">{model.name}</span>
                      <span class="model-meta">
                        {model.details?.parameter_size && <span>{model.details.parameter_size}</span>}
                        {model.details?.quantization_level && <span>{model.details.quantization_level}</span>}
                        {model.size && <span>{(model.size / 1024 ** 3).toFixed(1)}GB</span>}
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </section>

            {/* ── Env overrides hint ── */}
            <section class="llm-section llm-section--muted">
              <h2 class="llm-section__heading">Env overrides</h2>
              <dl class="env-grid">
                <>
                  <dt>LLAAB_LOCAL_SMALL_MODEL</dt>
                  <dd>local-small tier default</dd>
                </>
                <>
                  <dt>LLAAB_LOCAL_MID_MODEL</dt>
                  <dd>local-mid tier default</dd>
                </>
                <>
                  <dt>LLAAB_REMOTE_MODEL</dt>
                  <dd>remote tier default</dd>
                </>
              </dl>
            </section>
          </div>
        )
      }
    </div>
  </PageLayout>
</AppLayout>

<style>
  .llm-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: 640px;
  }

  /* ── Alert ── */

  .alert {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: 12px 14px;
    border-radius: var(--radius);
    border: 1px solid transparent;
  }

  .alert--error {
    background: var(--error-bg);
    border-color: var(--error-border);
  }

  .alert__label {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--error-text);
  }

  .alert__msg {
    font-size: var(--text-base);
    color: var(--error-text);
  }

  /* ── Sections ── */

  .llm-sections {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .llm-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .llm-section__heading {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-subtle);
  }

  .llm-section__badge {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    border-radius: 99px;
    padding: 1px 6px;
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    border: 1px solid transparent;
  }

  .llm-section__badge--ok {
    background: var(--success-bg);
    border-color: var(--success-border);
    color: var(--success-text);
  }

  .llm-section__badge--err {
    background: var(--error-bg);
    border-color: var(--error-border);
    color: var(--error-text);
  }

  .llm-section--muted .llm-section__heading {
    color: var(--text-faint);
    opacity: 0.6;
  }

  .llm-empty {
    font-size: var(--text-base);
    color: var(--text-faint);
  }

  /* ── Route grid ── */

  .route-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .route-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-base);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border-subtle);
  }

  .route-task {
    font-weight: 500;
    color: var(--text);
    width: 60px;
    flex-shrink: 0;
  }

  .route-arrow {
    color: var(--text-faint);
    flex-shrink: 0;
  }

  .route-tier {
    color: var(--text-muted);
    font-size: var(--text-md);
    width: 120px;
    flex-shrink: 0;
  }

  .route-model {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-md);
    flex: 1;
  }

  .route-model--ok {
    color: var(--text);
  }
  .route-model--missing {
    color: var(--warning-text);
  }

  .route-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-left: auto;
  }

  .route-dot--ok {
    background: var(--success-text);
  }
  .route-dot--missing {
    background: var(--warning-text);
  }

  /* ── Model list ── */

  .model-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .model-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border-subtle);
  }

  .model-name {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--text);
  }

  .model-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  /* ── Env grid ── */

  .env-grid {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-md);
  }

  .env-grid dt {
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .env-grid dd {
    color: var(--text-faint);
  }
</style>
