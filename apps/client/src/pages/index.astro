---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Home">
  <div class="home">
    <header class="home__hero">
      <p class="eyebrow">Learning Loop &amp; Agent Automation Base</p>
      <h1 class="home__heading">LLAAB</h1>
      <p class="home__sub">
        Your vault for ingested knowledge, structured nodes, and agent run history.
      </p>
    </header>

    <div class="home__grid">
      <a href="/ingest" class="home-card">
        <div class="home-card__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3v13M7 11l5 5 5-5" />
            <path d="M5 21h14" />
          </svg>
        </div>
        <div class="home-card__body">
          <h2 class="home-card__title">Ingest</h2>
          <p class="home-card__desc">Fetch a YouTube transcript and store it as a vault node.</p>
        </div>
        <span class="home-card__arrow" aria-hidden="true">→</span>
      </a>

      <a href="/vault" class="home-card">
        <div class="home-card__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <circle cx="12" cy="12" r="3" />
            <path d="M12 9V7M12 17v-2M9 12H7M17 12h-2" />
          </svg>
        </div>
        <div class="home-card__body">
          <h2 class="home-card__title">Vault</h2>
          <p class="home-card__desc">Browse transcripts, nodes, and structured vault content.</p>
        </div>
        <span class="home-card__arrow" aria-hidden="true">→</span>
      </a>

      <a href="/vault/runs" class="home-card">
        <div class="home-card__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="5 3 19 12 5 21 5 3" />
          </svg>
        </div>
        <div class="home-card__body">
          <h2 class="home-card__title">Runs</h2>
          <p class="home-card__desc">Inspect agent execution traces and skill run history.</p>
        </div>
        <span class="home-card__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</AppLayout>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    max-width: var(--content-max);
  }

  /* ── Hero ── */
  .home__hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .home__heading {
    font-family: var(--font-mono);
    font-size: 36px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .home__sub {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 480px;
  }

  /* ── Cards grid ── */
  .home__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-4);
  }

  .home-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--duration) var(--ease),
      background var(--duration) var(--ease);
    position: relative;
  }

  .home-card:hover {
    border-color: var(--accent);
    background: var(--surface-raised);
    text-decoration: none;
  }

  .home-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--accent-subtle);
    color: var(--accent);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .home-card__body {
    flex: 1;
    min-width: 0;
  }

  .home-card__title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: var(--space-1);
  }

  .home-card__desc {
    font-size: 12.5px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .home-card__arrow {
    font-size: 14px;
    color: var(--text-faint);
    flex-shrink: 0;
    transition: color var(--duration) var(--ease), transform var(--duration) var(--ease);
    display: inline-block;
  }

  .home-card:hover .home-card__arrow {
    color: var(--accent);
    transform: translateX(3px);
  }
</style>
