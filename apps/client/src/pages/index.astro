---
import AppLayout from 'layouts/AppLayout.astro';
import PageLayout from 'layouts/PageLayout.astro';
import PageHero from 'components/PageHero/PageHero.astro';
import BalancedGrid from 'components/BalancedGrid/BalancedGrid.astro';
import { ActivityIcon, ArrowRightIcon, DownloadIcon, FolderKanbanIcon, PlayIcon } from '@llaab/icons';
import { Card, CardContent } from 'components/ui/card';

const homeCalloutCount = 4;
---

<AppLayout title="Home">
  <PageLayout>
    <PageHero slot="hero" eyebrow="Learning Loop & Agent Automation Base" title="LLAAB">
      <Fragment slot="description">
        Your vault for ingested knowledge, structured nodes, and agent run history.
      </Fragment>
    </PageHero>

    <div class="home">
      <BalancedGrid itemCount={homeCalloutCount} class="home__grid">
        <a href="/ingest" class="home-card-link">
          <Card className="home-card">
            <CardContent className="home-card__content">
              <div class="home-card__icon">
                <DownloadIcon size={18} aria-hidden="true" />
              </div>
              <div class="home-card__body">
                <h2 class="home-card__title">Ingest</h2>
                <p class="home-card__desc">Fetch a YouTube transcript and store it as a vault node.</p>
              </div>
              <ArrowRightIcon size={14} className="home-card__arrow" aria-hidden="true" />
            </CardContent>
          </Card>
        </a>

        <a href="/vault" class="home-card-link">
          <Card className="home-card">
            <CardContent className="home-card__content">
              <div class="home-card__icon">
                <FolderKanbanIcon size={18} aria-hidden="true" />
              </div>
              <div class="home-card__body">
                <h2 class="home-card__title">Vault</h2>
                <p class="home-card__desc">Browse transcripts, nodes, and structured vault content.</p>
              </div>
              <ArrowRightIcon size={14} className="home-card__arrow" aria-hidden="true" />
            </CardContent>
          </Card>
        </a>

        <a href="/vault/runs" class="home-card-link">
          <Card className="home-card">
            <CardContent className="home-card__content">
              <div class="home-card__icon">
                <PlayIcon size={18} aria-hidden="true" />
              </div>
              <div class="home-card__body">
                <h2 class="home-card__title">Runs</h2>
                <p class="home-card__desc">Inspect agent execution traces and skill run history.</p>
              </div>
              <ArrowRightIcon size={14} className="home-card__arrow" aria-hidden="true" />
            </CardContent>
          </Card>
        </a>

        <a href="/llm" class="home-card-link">
          <Card className="home-card">
            <CardContent className="home-card__content">
              <div class="home-card__icon">
                <ActivityIcon size={18} aria-hidden="true" />
              </div>
              <div class="home-card__body">
                <h2 class="home-card__title">Models</h2>
                <p class="home-card__desc">Task routing, provider status, and installed model indicators.</p>
              </div>
              <ArrowRightIcon size={14} className="home-card__arrow" aria-hidden="true" />
            </CardContent>
          </Card>
        </a>
      </BalancedGrid>
    </div>
  </PageLayout>
</AppLayout>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    max-width: var(--content-max);
  }

  /* ── Cards grid (layout handled by BalancedGrid; class hooks page-specific overrides) ── */

  .home-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .home-card-link:hover {
    text-decoration: none;
    color: inherit;
  }

  /* Override shadcn Card's default py-4 gap to fit the horizontal layout */
  :global(.home-card) {
    padding: 0;
    gap: 0;
    transition:
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease);
  }

  :global(.home-card-link:hover .home-card) {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent-subtle);
  }

  :global(.home-card__content) {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-5) !important;
  }

  .home-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    background: var(--accent-subtle);
    color: var(--accent);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .home-card__body {
    flex: 1;
    min-width: 0;
  }

  .home-card__title {
    font-size: var(--text-ui);
    font-weight: 600;
    color: var(--text);
    margin-bottom: var(--space-1);
  }

  .home-card__desc {
    font-size: var(--text-md);
    color: var(--text-muted);
    line-height: 1.5;
  }

  :global(.home-card__arrow) {
    flex-shrink: 0;
    color: var(--text-faint);
    margin-top: 2px;
    transition:
      color var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  :global(.home-card-link:hover .home-card__arrow) {
    color: var(--accent);
    transform: translateX(3px);
  }
</style>
