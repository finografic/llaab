---
import AppLayout from '../../layouts/AppLayout.astro';

const iconsUrl = 'http://localhost:5199/';
---

<AppLayout title="Dev · Icons">
  <div class="dev-icons-page">
    <header class="dev-icons-page__header">
      <p class="eyebrow">Development</p>
      <h1 class="dev-icons-page__heading">Icons</h1>
      <p class="dev-icons-page__desc">
        Embedded Lucide picker for the local `@llaab/icons` registry.
      </p>
    </header>

    <div class="dev-icons-toolbar">
      <a href={iconsUrl} target="_blank" rel="noreferrer noopener" class="dev-icons-link">
        Open standalone picker
      </a>
      <span class="dev-icons-meta">Source: {iconsUrl}</span>
    </div>

    <div class="dev-icons-frame-shell">
      <iframe
        src={iconsUrl}
        title="Lucide Manager"
        loading="lazy"
        class="dev-icons-frame"
      ></iframe>
    </div>
  </div>
</AppLayout>

<style>
  .dev-icons-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    min-height: 100%;
  }

  .dev-icons-page__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 680px;
  }

  .dev-icons-page__heading {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .dev-icons-page__desc {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .dev-icons-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 12px 14px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .dev-icons-link {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .dev-icons-link:hover {
    text-decoration: underline;
  }

  .dev-icons-meta {
    font-size: 12px;
    color: var(--text-faint);
  }

  .dev-icons-frame-shell {
    flex: 1;
    min-height: 680px;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 2px);
    overflow: hidden;
    background: #0f1117;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.02);
  }

  .dev-icons-frame {
    display: block;
    width: 100%;
    min-height: 680px;
    height: calc(100vh - 255px);
    border: 0;
    background: transparent;
  }

  @media (max-width: 820px) {
    .dev-icons-toolbar {
      flex-direction: column;
      align-items: flex-start;
    }

    .dev-icons-frame {
      height: 72vh;
    }
  }
</style>
