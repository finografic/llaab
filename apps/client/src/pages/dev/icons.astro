---
import { readFile } from 'node:fs/promises';
import { fileURLToPath } from 'node:url';
import { resolve } from 'node:path';
import AppLayout from 'layouts/AppLayout.astro';
import PageLayout from 'layouts/PageLayout.astro';
import PageHero from 'components/PageHero/PageHero.astro';

// Anchor to this file's location (apps/client/src/pages/dev/) — 5 levels up = workspace root
const configPath = resolve(
  fileURLToPath(new URL('.', import.meta.url)),
  '../../../../..',
  'packages/icons/lucide-manager.config.json',
);
const rawConfig = JSON.parse(await readFile(configPath, 'utf-8')) as {
  manager?: {
    server?: {
      host?: string;
      port?: number;
    };
  };
};

const pickerPort = rawConfig.manager?.server?.port ?? 5199;
const configuredHost = rawConfig.manager?.server?.host;
const pickerHost =
  configuredHost && configuredHost !== '0.0.0.0' && configuredHost !== '::' && configuredHost !== '::1'
    ? configuredHost
    : 'localhost';
const iconsUrl = `http://${pickerHost}:${pickerPort}/`;
---

<AppLayout title="Dev · Icons">
  <PageLayout>
    <PageHero slot="hero" eyebrow="System" title="Icons">
      <Fragment slot="description">Embedded Lucide picker for the local `@llaab/icons` registry.</Fragment>
    </PageHero>

    <div class="dev-icons-page">
      <div class="dev-icons-frame-shell">
        <iframe src={iconsUrl} title="Lucide Manager" loading="lazy" class="dev-icons-frame"></iframe>
      </div>

      <div class="dev-icons-toolbar">
        <a href={iconsUrl} target="_blank" rel="noreferrer noopener" class="dev-icons-link">
          Open standalone picker
        </a>
        <span class="dev-icons-meta">Source: {iconsUrl}</span>
      </div>
    </div>
  </PageLayout>
</AppLayout>

<style>
  .dev-icons-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .dev-icons-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 12px 14px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .dev-icons-link {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .dev-icons-link:hover {
    text-decoration: underline;
  }

  .dev-icons-meta {
    font-size: var(--text-md);
    color: var(--text-faint);
  }

  .dev-icons-frame-shell {
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 2px);
    overflow: hidden;
    background: #000;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.02);
  }

  .dev-icons-frame {
    display: block;
    width: 100%;
    height: calc(100vh - 330px);
    min-height: 580px;
    border: 0;
    background: transparent;
  }

  @media (max-width: 820px) {
    .dev-icons-toolbar {
      flex-direction: column;
      align-items: flex-start;
    }

    .dev-icons-frame {
      height: 72vh;
    }
  }
</style>
