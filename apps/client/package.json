{
  "name": "@llaab/client",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "---------- DEV_AND_BUILD": "---------------------------------------------",
    "dev": "astro dev",
    "build": "astro build",
    "astro": "astro",
    "·········· CLEAN": "·····················································",
    "clean": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --detach",
    "clean:dry": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --dry-run",
    "·········· LINTING": "···················································",
    "lint": "oxlint -c oxlint.config.ts",
    "lint:fix": "oxlint -c oxlint.config.ts --fix",
    "·········· FORMATTING": "················································",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "·········· TESTING": "····················································",
    "test:all": "vitest run --reporter=verbose",
    "test:filters": "vitest run src/utils/filters --reporter=verbose",
    "·········· PACKAGES": "···················································",
    "update:project-scripts": "pnpm update @finografic/project-scripts --latest --recursive",
    "update:deps:all": "pnpm update --latest",
    "update:deps:ignore": "npx tsx scripts/update-deps-ignore.ts",
    "·········· UTILS": "······················································",
    "tsc:debug": "pnpm exec tsc --pretty --project tsconfig.json",
    "typecheck": "pnpm exec tsc --project tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@astrojs/node": "^10.1.3",
    "@astrojs/react": "^5.0.7",
    "@finografic/zustand-context-creator": "^1.2.0",
    "@fontsource-variable/roboto": "^5.2.10",
    "@hookform/resolvers": "^5.4.0",
    "@llaab/core": "workspace:*",
    "@llaab/icons": "workspace:*",
    "@llaab/schemas": "workspace:*",
    "@llaab/ui": "workspace:*",
    "@react-router/dev": "^7.17.0",
    "@tanstack/query-sync-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "@tanstack/react-table": "^8.21.3",
    "astro": "^6.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.23",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "react-json-tree": "^0.20.0",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "type-fest": "^5.7.0",
    "use-debounce": "^10.1.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9",
    "@finografic/md-lint": "^0.16.4",
    "@finografic/oxc-config": "^2.7.0",
    "@finografic/project-scripts": "^1.3.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^0.23.0",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.0"
  }
}
