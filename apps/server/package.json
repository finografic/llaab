{
  "name": "@llaab/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "··········· DEV": "·····················································",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "·········· CLEAN": "·····················································",
    "clean": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --detach",
    "clean:turbo": "turbo run clean",
    "··········· LINTING": "·················································",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "··········· FORMATTING": "·············································",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "··········· UTILS": "···················································",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@llaab/core": "workspace:*",
    "@llaab/ingestion": "workspace:*",
    "@llaab/llm": "workspace:*",
    "@llaab/schemas": "workspace:*",
    "@llaab/skills": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.12.14",
    "http-status-codes": "^2.3.0",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@finografic/project-scripts": "^1.3.3",
    "@types/bun": "latest",
    "@types/node": "24.12.2"
  }
}
