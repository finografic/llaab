{
  "name": "@llaab/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "··········· DEV": "·····················································",
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "·········· CLEAN": "·····················································",
    "clean": "pnpm --package=@finografic/project-scripts dlx purge-builds --recursive --detach",
    "clean:turbo": "turbo run clean",
    "··········· LINTING": "·················································",
    "lint": "oxlint -c ../../oxlint.config.ts",
    "lint:fix": "oxlint -c ../../oxlint.config.ts --fix",
    "··········· FORMATTING": "·············································",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "··········· UTILS": "···················································",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@llaab/core": "workspace:*",
    "@llaab/ingestion": "workspace:*",
    "@llaab/llm": "workspace:*",
    "@llaab/schemas": "workspace:*",
    "@llaab/skills": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.12.14",
    "http-status-codes": "^2.3.0",
    "marked": "^18.0.5",
    "picocolors": "^1.1.1",
    "sanitize-html": "^2.17.5",
    "shiki": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@finografic/project-scripts": "^1.3.3",
    "@types/bun": "1.3.14",
    "@types/node": "25.9.2",
    "@types/sanitize-html": "^2.16.1"
  }
}
