# ── Tooling ───────────────────────────────────────────────────────────────────
# GitHub Packages auth for @finografic/* (see .npmrc)
NPM_TOKEN=

# ── App server & browser auth (server-only) ───────────────────────────────────
# Vite proxy target for /api and /terminal (not exposed to the browser bundle)
LLAAB_API_URL=http://localhost:8888
# Optional API key — unset = auth disabled for API writes
LLAAB_API_KEY=
# Optional browser login — unset = no login gate for app writes
LLAAB_PASSWORD=
# Session cookie signing secret when LLAAB_PASSWORD is set
LLAAB_COOKIE_SECRET=
# Optional hosted deployment only — set VAULT_PASSWORD to gate /vault (omit for open local vault)

# ── Client (Vite dev / launchd — server launchd plist pins PORT=8888) ────────
PORT=5050

# ── Run timeouts (milliseconds — plain digits only, no 1_200_000 separators) ─
# LLAAB_RUN_STALE_MS=1800000                   # active run auto-fail (default 30m; all skills)
# LLAAB_LMSTUDIO_COMPLETION_TIMEOUT_MS=1200000 # LM Studio chat abort (default 20m)

# ── Local models (Ollama) ─────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
LLAAB_LOCAL_MID_MODEL=gemma4:e4b-it-qat
# LLAAB_LOCAL_SMALL_MODEL=llama3.2:3b
# LLAAB_LOCAL_STRONG_MODEL=gpt-oss:20b

# ── LM Studio (optional overrides) ────────────────────────────────────────────
# LLAAB_LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LLAAB_LMSTUDIO_MODEL=google/gemma-4-e4b

# ── Anthropic (remote tier default) ───────────────────────────────────────────
ANTHROPIC_API_KEY=
# LLAAB_REMOTE_MODEL=claude-sonnet-4-6

# ── OpenCode (cloud) ──────────────────────────────────────────────────────────
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=qwen3.7-plus
OPENCODE_MODELS=qwen3.7-plus,mimo-v2.5,glm-5.2

# ── YouTube enrichment (optional) ─────────────────────────────────────────────
YOUTUBE_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
