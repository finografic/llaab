# Github token
NPM_TOKEN=

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENCODE_API_KEY=

# Local runtime
OLLAMA_HOST=http://localhost:11434
LLAAB_LOCAL_MID_MODEL=gemma4:e4b-it-qat  # override default llama3.1:8b if not installed

# Client (Vite dev / launchd)
PORT=5050

# Vite dev/preview proxy target for /api and /terminal (not exposed to the browser bundle)
LLAAB_API_URL=http://localhost:8888
# Optional Bun API key (server-only; unset = auth disabled)
LLAAB_API_KEY=

# Vault UI session (server-only — unset or empty = no vault login required)
VAULT_PASSWORD=

# YouTube enrichment (optional — public channel metadata uses yt-dlp without these)
YOUTUBE_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# LLM Stats API key
LL_STATS_API_KEY=
