# Github token
NPM_TOKEN=

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local runtime
OLLAMA_HOST=http://localhost:11434
LLAAB_LOCAL_MID_MODEL=llama3.2:3b   # override default llama3.1:8b if not installed

# Server
SERVER_URL=http://localhost:3000
SERVER_API_KEY=

# YouTube enrichment (optional — public channel metadata uses yt-dlp without these)
YOUTUBE_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
