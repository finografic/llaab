# ── Tooling ───────────────────────────────────────────────────────────────────
# GitHub Packages auth for @finografic/* (see .npmrc)
NPM_TOKEN=

# ── App server & browser auth (server-only) ───────────────────────────────────
# Vite proxy for /api + /terminal — not in browser bundle
LLAAB_API_URL=http://localhost:8888
# Unset = API writes open locally
LLAAB_API_KEY=
# Unset = no browser login gate for app writes
LLAAB_PASSWORD=
# Required when LLAAB_PASSWORD is set
LLAAB_COOKIE_SECRET=

# ── Client (Vite dev / launchd — server launchd plist pins PORT=8888) ────────
PORT=5050

# ── Run timeouts (milliseconds — plain digits only, no 1_200_000 separators) ─
LLAAB_RUN_STALE_MS=1800000
LLAAB_LMSTUDIO_COMPLETION_TIMEOUT_MS=1200000

# ── Local models (Ollama) ─────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
LLAAB_LOCAL_MID_MODEL=gemma4:e4b-it-qat

# ── Anthropic (remote tier default) ───────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── OpenCode Go (cloud) ───────────────────────────────────────────────────────
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=qwen3.7-plus

# ── YouTube enrichment (optional) ─────────────────────────────────────────────
# youtube_subscribed OAuth setup: docs/integrations/youtube-oauth.md
YOUTUBE_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ── GitHub registry (optional — higher rate limits for /registry/repos) ───────
# Unauthenticated works with strict rate limits; a PAT is recommended.
GITHUB_TOKEN=
