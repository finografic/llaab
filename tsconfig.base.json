{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@llaab/schemas": ["./packages/schemas/src/index.ts"],
      "@llaab/core": ["./packages/core/src/index.ts"],
      "@llaab/control": ["./packages/control/src/index.ts"],
      "@llaab/ingestion": ["./packages/ingestion/src/index.ts"],
      "@llaab/llm": ["./packages/llm/src/index.ts"],
      "@llaab/skills": ["./packages/skills/src/index.ts"]
    },
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": [],
  "exclude": ["node_modules", "./dist"]
}
